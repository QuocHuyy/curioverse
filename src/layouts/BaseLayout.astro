---
import '@fontsource-variable/jetbrains-mono/index.css';
import '~/styles/global.css';

import Fonts from '~/components/Fonts.astro';
import Sky from '~/components/Sky.astro';
import Seo, { type SeoProps } from '~/components/Seo.astro';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import SearchDialog from '~/components/SearchDialog.astro';
import { counterpartPath, otherLang, t, url } from '~/i18n/utils';

type Props = SeoProps & {
  /** Thêm class cho <main> */
  mainClass?: string;
  /** Kích thước bầu trời đầu trang (xem Sky.astro) */
  sky?: 'tall' | 'short';
};

const props = Astro.props as Props;
const { lang, mainClass, sky = 'short' } = props;
const tr = t(lang);
const target = otherLang(lang);
const exact = Boolean(props.alternates?.[target]);
const langHref = props.alternates?.[target] ?? counterpartPath(Astro.url.pathname, target);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#7cc8ff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#070519" media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      (() => {
        let theme;
        try {
          theme = localStorage.getItem('theme');
        } catch {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <Fonts lang={lang} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <Seo {...props} />
    <slot name="head" />
  </head>
  <body id="top">
    <Sky size={sky} />
    <a class="skip-link" href="#main">{tr('nav.skip')}</a>
    <Header lang={lang} langHref={langHref} langExact={exact} />
    <main id="main" class={mainClass} tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <SearchDialog lang={lang} />
  </body>
</html>
