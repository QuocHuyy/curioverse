---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Icon from '~/components/Icon.astro';
import Mascot from '~/components/Mascot.astro';
import { cellsPath, discCells, ringCells } from '~/lib/pixel';
import { sectionUrl, t } from '~/i18n/utils';
const vi = t('vi');
const en = t('en');

// Hố đen pixel (lưới 61×61): lõi đen, vành sáng, 3 vòng bồi tụ chấm điểm quay ngược chiều nhau
const C = 30;
const core = cellsPath(discCells(C, C, 9));
const rim = cellsPath(ringCells(C, C, 10));
const ring = (r: number, every: number, phase = 0) =>
  cellsPath(ringCells(C, C, r).filter(([x, y]) => (Math.round((Math.atan2(y - C, x - C) + Math.PI) * r) + phase) % every === 0));
const rings = [
  { d: ring(15, 3), cls: 'r1' },
  { d: ring(21, 4, 1), cls: 'r2' },
  { d: ring(28, 5, 2), cls: 'r3' },
];
---

<BaseLayout lang="vi" title={vi('404.title')} description={vi('404.lead')} noindex>
  <section class="container lost">
    <div class="hole" aria-hidden="true">
      <svg viewBox="0 0 61 61" shape-rendering="crispEdges">
        {rings.map((r) => <path class:list={['ring', r.cls]} d={r.d} />)}
        <path class="rim" d={rim} />
        <path class="core" d={core} />
      </svg>
      <span class="drifter"><Mascot mood="sad" size={69} /></span>
    </div>
    <p class="eyebrow"><span class="glyph">✦</span> Error 404</p>
    <h1 class="title-pop">{vi('404.title')}</h1>
    <p class="lead">{vi('404.lead')}</p>
    <p class="en" lang="en">{en('404.title')} — {en('404.lead')}</p>
    <div class="cta">
      <a class="btn btn-primary" href={sectionUrl('home', 'vi')}><Icon name="arrow-left" /> {vi('404.home')}</a>
      <a class="btn" href={sectionUrl('universe', 'vi')}><Icon name="map" /> {vi('404.universe')}</a>
    </div>
  </section>
</BaseLayout>

<style>
  .lost {
    display: grid;
    justify-items: center;
    text-align: center;
    padding-block: clamp(3rem, 7vw, 5rem);
  }
  .lost h1 {
    font-size: var(--step-5);
    line-height: 1;
    margin-block: var(--space-m) var(--space-m);
  }
  .lead {
    margin-inline: auto;
  }
  .en {
    margin-top: var(--space-s);
    color: var(--ink-3);
    font-size: var(--step--1);
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    justify-content: center;
    margin-top: var(--space-xl);
  }
  .hole {
    position: relative;
    width: 244px;
    height: 244px;
    margin-bottom: var(--space-l);
  }
  .hole svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .core {
    fill: #05031a;
  }
  .rim {
    fill: var(--star-bright);
  }
  .ring {
    transform-origin: 30.5px 30.5px;
  }
  .r1 {
    fill: var(--pop);
  }
  .r2 {
    fill: var(--work-bright);
  }
  .r3 {
    fill: var(--note-bright);
    opacity: 0.8;
  }
  .drifter {
    position: absolute;
    right: -2.4rem;
    top: -0.6rem;
  }
  @media (prefers-reduced-motion: no-preference) {
    .r1 {
      animation: spin 6s steps(24, end) infinite;
    }
    .r2 {
      animation: spin 11s steps(32, end) infinite reverse;
    }
    .r3 {
      animation: spin 18s steps(40, end) infinite;
    }
    .drifter {
      animation: drift 5s steps(10, end) infinite alternate;
    }
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes drift {
    from {
      transform: translate(0, 0) rotate(0deg);
    }
    to {
      transform: translate(-10px, 8px) rotate(-12deg);
    }
  }
</style>
