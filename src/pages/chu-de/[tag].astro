---
import TopicView from '~/views/TopicView.astro';
import { getTags } from '~/lib/content';

export async function getStaticPaths() {
  const tags = await getTags('vi');
  return tags.map((x) => ({ params: { tag: x.slug }, props: { tag: x.tag, items: x.items } }));
}
const { tag, items } = Astro.props;
---

<TopicView lang="vi" tag={tag} slug={Astro.params.tag!} items={items} />
