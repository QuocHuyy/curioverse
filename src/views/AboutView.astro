---
import { getEntry, render } from 'astro:content';
import '~/styles/prose.css';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Icon from '~/components/Icon.astro';
import Sigil from '~/components/Sigil.astro';
import { mdxComponents } from '~/components/mdx';
import { SITE } from '~/site.config';
import { sectionUrl, t, type Lang } from '~/i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);
const entry = (await getEntry('pages', `${lang}/about`)) ?? (await getEntry('pages', 'vi/about'));
if (!entry) throw new Error('Thiếu src/content/pages/vi/about.mdx');
const { Content } = await render(entry);
const jsonLd = {
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Person',
    name: SITE.fullName,
    alternateName: SITE.author,
    jobTitle: SITE.role[lang],
    homeLocation: SITE.location[lang],
    image: SITE.avatar,
    sameAs: SITE.socials.map((s) => s.href),
  },
};
---

<BaseLayout
  lang={lang}
  title={entry.data.title}
  description={entry.data.description}
  alternates={{ vi: sectionUrl('about', 'vi'), en: sectionUrl('about', 'en') }}
  jsonLd={jsonLd}
>
  <div class="container about">
    <aside class="card">
      <div class="portrait">
        <div class="ring" aria-hidden="true"><Sigil seed="about-huy" chart twinkle /></div>
        <img src={SITE.avatar} alt={SITE.fullName} width="160" height="160" loading="eager" />
      </div>
      <p class="name">{SITE.author}</p>
      <p class="role">{SITE.role[lang]}</p>
      <dl class="facts">
        <div>
          <dt>{tr('about.basedIn')}</dt>
          <dd>{SITE.location[lang]}</dd>
        </div>
      </dl>
      <p class="elsewhere-title">{tr('about.elsewhere')}</p>
      <ul class="elsewhere">
        {
          SITE.socials.map((s) => (
            <li>
              <a href={s.href} rel="me noopener">
                <Icon name={s.id} /> {s.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href={sectionUrl('now', lang)}><Icon name="sprout" /> {tr('nav.now')}</a>
        </li>
      </ul>
    </aside>
    <article class="content" data-pagefind-body data-pagefind-meta={`kind:${tr('nav.about')}`}>
      <p class="eyebrow"><span class="glyph">✦</span> {tr('nav.about')}</p>
      <h1>{entry.data.title}</h1>
      <div class="prose">
        <Content components={mdxComponents} />
      </div>
    </article>
  </div>
</BaseLayout>

<style>
  .about {
    display: grid;
    grid-template-columns: 17rem minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    padding-top: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .card {
    position: sticky;
    top: calc(var(--header-h) + 1.5rem);
    display: grid;
    justify-items: start;
    gap: 0.3rem;
    padding: var(--space-l);
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    background: var(--bg-elev);
  }
  .portrait {
    position: relative;
    width: 9rem;
    height: 9rem;
    margin-bottom: var(--space-m);
  }
  .ring {
    position: absolute;
    inset: -1.6rem;
    opacity: 0.8;
  }
  .portrait img {
    position: relative;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    border: 3px solid var(--bg-elev);
    box-shadow: 0 0 0 1px var(--line-strong);
  }
  .name {
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 600;
    line-height: 1.1;
  }
  .role {
    color: var(--ink-3);
  }
  .facts {
    margin-top: var(--space-m);
    display: grid;
    gap: 0.4rem;
    width: 100%;
  }
  .facts div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: var(--step--1);
    border-top: 1px dashed var(--line);
    padding-top: 0.4rem;
  }
  .facts dt {
    color: var(--ink-3);
  }
  .facts dd {
    margin: 0;
    font-weight: 500;
    text-align: right;
  }
  .elsewhere-title {
    margin-top: var(--space-m);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .elsewhere {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.3rem;
    font-size: var(--step--1);
  }
  .elsewhere a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    text-decoration: none;
  }
  .content h1 {
    font-size: var(--step-5);
    line-height: 1.12;
    margin-block: var(--space-s) var(--space-xl);
  }
  @media (max-width: 860px) {
    .about {
      grid-template-columns: 1fr;
    }
    .card {
      position: static;
    }
  }
</style>
