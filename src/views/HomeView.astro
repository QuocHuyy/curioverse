---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Icon from '~/components/Icon.astro';
import MiniConstellation from '~/components/MiniConstellation.astro';
import EntryCard from '~/components/EntryCard.astro';
import WorkCard from '~/components/WorkCard.astro';
import JourneyStrip from '~/components/JourneyStrip.astro';
import Mascot from '~/components/Mascot.astro';
import { getGraph } from '~/lib/graph';
import { SITE } from '~/site.config';
import TagList from '~/components/TagList.astro';
import { formatDate, sectionUrl, t, url, type Lang } from '~/i18n/utils';
import { getListing, getMilestones, getNowEntries, getTags, plainExcerpt } from '~/lib/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);

// Câu chuyện + ghi chép gộp thành một dòng "mới viết" — trang chủ không còn khối trống khi một loại chưa có bài
const stories = await getListing('stories', lang);
const notes = await getListing('notes', lang);
const writing = [...stories.primary, ...stories.fallback, ...notes.primary, ...notes.fallback].sort(
  (a, b) => b.sortDate.getTime() - a.sortDate.getTime(),
);
// Bài dẫn: câu chuyện nổi bật mới nhất (câu chuyện là lõi), nếu không có thì bài mới nhất
const lead = writing.find((i) => i.kind === 'stories' && i.featured) ?? writing[0];
const rest = writing.filter((i) => i !== lead).slice(0, 4);
const hasNotes = notes.primary.length + notes.fallback.length > 0;
// Khi còn ít bài, cột phải là "lối vào khác" (chủ đề, bản đồ, RSS) thay vì để trống
const sparse = rest.length < 2;
const topTags = sparse ? (await getTags(lang)).slice(0, 8).map((x) => x.tag) : [];

const work = await getListing('work', lang);
const allWork = [...work.primary, ...work.fallback];
const featuredWork = [...allWork.filter((w) => w.featured), ...allWork.filter((w) => !w.featured)].slice(0, 3);
const milestones = await getMilestones(lang);
const [now] = await getNowEntries(lang);
const starCount = (await getGraph(lang)).nodes.length;

// Đánh số mục theo những mục thật sự hiện ra
const shown = [lead && 'latest', featuredWork.length > 0 && 'work', milestones.length > 0 && 'journey'].filter(Boolean);
const num = (id: string) => String(shown.indexOf(id) + 1).padStart(2, '0');

const jsonLd = [
  {
    '@type': 'WebSite',
    name: SITE.name,
    url: new URL(sectionUrl('home', lang), Astro.site).href,
    inLanguage: lang,
    description: SITE.description[lang],
  },
  {
    '@type': 'Person',
    name: SITE.fullName,
    alternateName: SITE.author,
    jobTitle: SITE.role[lang],
    homeLocation: SITE.location[lang],
    url: new URL(sectionUrl('about', lang), Astro.site).href,
    sameAs: SITE.socials.map((s) => s.href),
  },
];
const alternates = { vi: sectionUrl('home', 'vi'), en: sectionUrl('home', 'en') };
---

<BaseLayout lang={lang} alternates={alternates} jsonLd={jsonLd} mainClass="home" sky="tall">
  <section class="hero container">
    <div class="hero-text">
      <p class="eyebrow"><span class="glyph">✦</span> {tr('home.eyebrow')}</p>
      <h1 class="title-pop">{tr('home.hello')}</h1>
      <div class="dialogue px">
        <p class="nameplate"><span>{SITE.author}</span> <span class="np-role">{SITE.role[lang]}</span></p>
        <p class="lead">{tr('home.lead')}</p>
        <span class="dlg-next" aria-hidden="true"></span>
      </div>
      <div class="hero-cta">
        <a class="btn btn-primary" href={sectionUrl('stories', lang)}>{tr('home.ctaStories')} <Icon name="arrow-right" /></a>
        <a class="btn" href={sectionUrl('universe', lang)}><Icon name="map" /> {tr('home.ctaUniverse')}</a>
      </div>
    </div>

    <div class="hero-art">
      <div class="screen px">
        <p class="win-bar" aria-hidden="true">
          <span class="glyph">✦</span> {tr('home.mapWindow')}
          <span class="sb-count">· {starCount} {tr('home.stars')}</span>
          <span class="win-dots"><i></i><i></i><i></i></span>
        </p>
        <div class="screen-body sky-window">
          <MiniConstellation lang={lang} />
          <div class="curio" aria-hidden="true">
            <Mascot size={60} />
            <p class="bubble">{tr('home.mascotHint')}</p>
          </div>
        </div>
        <div class="screen-foot">
          <ul class="legend" aria-hidden="true">
            <li data-kind="stories"><i></i>{tr('kind.stories')}</li>
            <li data-kind="work"><i></i>{tr('kind.work.one')}</li>
            <li data-kind="notes"><i></i>{tr('kind.notes')}</li>
          </ul>
          <a class="open-map" href={sectionUrl('universe', lang)}>{tr('home.openMap')} <Icon name="arrow-right" /></a>
        </div>
      </div>
    </div>
  </section>

  {
    now && (
      <section class="container now-strip" aria-labelledby="now-title">
        <a href={sectionUrl('now', lang)} class="now-card px-soft px-lift" data-kind="notes">
          <span class="now-head">
            <span class="now-pulse" aria-hidden="true" />
            <span class="now-label" id="now-title">
              {tr('home.now')}
            </span>
            <time class="now-date" datetime={now.entry.data.date.toISOString()}>
              {formatDate(now.entry.data.date, lang)}
            </time>
          </span>
          <span class="now-text">{plainExcerpt(now.entry.body ?? '', 220)}</span>
          <span class="now-more">
            {tr('home.nowMore')} <Icon name="arrow-right" />
          </span>
        </a>
      </section>
    )
  }

  {
    lead && (
      <section class="container section" aria-labelledby="h-latest">
        <div class="section-head">
          <div>
            <p class="eyebrow">
              <span class="num">{num('latest')}</span> {tr('home.latestEyebrow')}
            </p>
            <h2 id="h-latest">{tr('home.latest')}</h2>
          </div>
          <div class="section-links">
            <a class="more" href={sectionUrl('stories', lang)}>
              {tr('home.allStories')} <Icon name="arrow-right" />
            </a>
            {hasNotes && (
              <a class="more" href={sectionUrl('notes', lang)}>
                {tr('home.allNotes')} <Icon name="arrow-right" />
              </a>
            )}
          </div>
        </div>
        <div class="latest">
          <EntryCard item={lead} lang={lang} variant="feature" showKind />
          {(rest.length > 0 || sparse) && (
            <div class="latest-list">
              {rest.map((item) => (
                <EntryCard item={item} lang={lang} variant="compact" showKind />
              ))}
              {sparse && (
                <aside class="explore px-flat" aria-labelledby="h-explore">
                  <h3 id="h-explore">{tr('home.explore')}</h3>
                  <p class="explore-lead">{tr('home.exploreLead')}</p>
                  {topTags.length > 0 && <TagList tags={topTags} lang={lang} />}
                  <ul class="explore-links">
                    <li>
                      <a href={sectionUrl('universe', lang)}>
                        <Icon name="map" /> {tr('nav.universe')}
                      </a>
                    </li>
                    <li>
                      <a href={sectionUrl('topics', lang)}>
                        <Icon name="tag" /> {tr('nav.topics')}
                      </a>
                    </li>
                    <li>
                      <a href={url(lang === 'en' ? '/en/rss.xml' : '/rss.xml')}>
                        <Icon name="rss" /> RSS
                      </a>
                    </li>
                  </ul>
                </aside>
              )}
            </div>
          )}
        </div>
      </section>
    )
  }

  {
    featuredWork.length > 0 && (
      <section class="container section" aria-labelledby="h-work">
        <div class="section-head">
          <div>
            <p class="eyebrow">
              <span class="num">{num('work')}</span> {tr('nav.work')}
            </p>
            <h2 id="h-work">{tr('home.featuredWork')}</h2>
          </div>
          <a class="more" href={sectionUrl('work', lang)}>
            {tr('home.seeAll')} <Icon name="arrow-right" />
          </a>
        </div>
        <div class="work-stack">
          <WorkCard item={featuredWork[0]} lang={lang} size="large" />
          {featuredWork.length > 1 && (
            <div class="work-grid">
              {featuredWork.slice(1).map((item) => (
                <WorkCard item={item} lang={lang} />
              ))}
            </div>
          )}
        </div>
      </section>
    )
  }

  {
    milestones.length > 0 && (
      <section class="container section" aria-labelledby="h-journey">
        <div class="section-head">
          <div>
            <p class="eyebrow">
              <span class="num">{num('journey')}</span> {tr('nav.journey')}
            </p>
            <h2 id="h-journey">{tr('home.journey')}</h2>
          </div>
          <a class="more" href={sectionUrl('journey', lang)}>
            {tr('home.journeyMore')} <Icon name="arrow-right" />
          </a>
        </div>
        <JourneyStrip milestones={milestones} lang={lang} />
      </section>
    )
  }
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 4.5rem);
    padding-block: clamp(2rem, 5vw, 4rem) clamp(1.5rem, 3vw, 2.5rem);
  }
  .hero h1 {
    font-size: clamp(3rem, 1.9rem + 4.4vw, 5.75rem);
    line-height: 0.95;
    letter-spacing: 0.005em;
    margin-block: var(--space-m) var(--space-xl);
    font-weight: 800;
  }

  /* Hộp thoại kiểu visual novel */
  .dialogue {
    --s: calc(var(--pu) * 2);
    position: relative;
    max-width: 34rem;
    padding: 1.55rem 1.4rem 1.25rem;
    margin: 0 var(--pu);
    background: var(--bg-elev);
  }
  .nameplate {
    position: absolute;
    top: -1.05rem;
    left: 1rem;
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.1rem 0.7rem 0.15rem;
    background: var(--bar-bg);
    color: var(--bar-ink);
    font-family: var(--font-pixel);
    font-weight: 800;
    font-size: 1.3rem;
    line-height: 1.2;
    letter-spacing: 0.04em;
  }
  .np-role {
    font-family: var(--font-label);
    font-weight: 400;
    font-size: 1.05rem;
    color: var(--pop-soft);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  :global(:root[data-theme='dark']) .np-role {
    color: #3a1450;
  }
  .hero .lead {
    font-size: var(--step-1);
    color: var(--ink);
    line-height: 1.7;
  }
  .dlg-next {
    position: absolute;
    right: 0.9rem;
    bottom: 0.55rem;
    width: 12px;
    height: 8px;
    background: var(--pop);
    clip-path: polygon(0 0, 100% 0, 100% 25%, 83% 25%, 83% 50%, 67% 50%, 67% 75%, 50% 75%, 50% 100%, 50% 100%, 33% 75%, 33% 50%, 17% 50%, 17% 25%, 0 25%);
  }
  @media (prefers-reduced-motion: no-preference) {
    .dlg-next {
      animation: dlg-bounce 0.9s steps(1, end) infinite;
    }
  }
  @keyframes dlg-bounce {
    50% {
      transform: translateY(3px);
    }
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: var(--space-xl);
  }

  /* Cửa sổ "màn hình game" chứa chòm sao */
  .hero-art {
    padding: 0 var(--pu) var(--pu) 0;
  }
  .screen {
    --s: calc(var(--pu) * 3);
    --hard: var(--pop);
    margin: var(--pu);
    background: var(--bg-elev);
  }
  :global(:root[data-theme='dark']) .screen {
    --hard: #05031a;
  }
  .sb-count {
    opacity: 0.75;
  }
  .screen-body {
    position: relative;
    padding: 0.25rem;
  }
  .curio {
    position: absolute;
    left: 0.6rem;
    bottom: 0.5rem;
    display: flex;
    align-items: flex-start;
    gap: 0.25rem;
    pointer-events: none;
  }
  .bubble {
    position: relative;
    margin: 0 0 0 0.45rem;
    padding: 0.2rem 0.6rem 0.25rem;
    background: var(--bg-elev);
    color: var(--ink);
    font-family: var(--font-pixel);
    font-weight: 600;
    font-size: 1.08rem;
    line-height: 1.25;
    white-space: nowrap;
    box-shadow:
      0 -2px 0 0 var(--frame-hi),
      0 2px 0 0 var(--frame-hi),
      -2px 0 0 0 var(--frame-hi),
      2px 0 0 0 var(--frame-hi);
  }
  /* đuôi bong bóng thoại chỉ về phía Curio */
  .bubble::after {
    content: '';
    position: absolute;
    left: -11px;
    bottom: 2px;
    width: 10px;
    height: 10px;
    background: var(--frame-hi);
    clip-path: polygon(100% 0, 100% 100%, 0 100%, 0 80%, 20% 80%, 20% 60%, 40% 60%, 40% 40%, 60% 40%, 60% 20%, 80% 20%, 80% 0);
  }
  @media (prefers-reduced-motion: no-preference) {
    .bubble {
      animation: bubble-pop 6s steps(1, end) infinite;
    }
  }
  @keyframes bubble-pop {
    0%,
    8% {
      opacity: 0;
    }
    9%,
    70% {
      opacity: 1;
    }
    71%,
    100% {
      opacity: 0;
    }
  }
  .screen-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    padding: 0.5rem var(--card-pad) 0.6rem;
    background: linear-gradient(90deg, var(--line-strong) 50%, transparent 0) top left / 8px 2px repeat-x;
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.9rem;
    list-style: none;
    padding: 0;
    font-family: var(--font-label);
    font-size: 1.05rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .legend li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .legend i {
    width: 9px;
    height: 9px;
    background: var(--kind-bright);
    clip-path: var(--clip-gem);
  }
  .open-map {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-pixel);
    font-weight: 700;
    font-size: 1.15rem;
    text-decoration: none;
  }
  .open-map:hover {
    text-decoration: underline;
    text-decoration-thickness: 3px;
  }

  /* Dải "Bây giờ" — như bảng nhiệm vụ trong game */
  .now-strip {
    margin-top: var(--space-l);
  }
  .now-card {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-s) var(--space-l);
    margin: var(--pu);
    padding: 0.85rem var(--card-pad);
    background: var(--bg-elev);
    color: var(--ink-2);
    text-decoration: none;
  }
  .now-card:hover {
    color: var(--ink-2);
  }
  .now-head {
    display: grid;
    grid-template-columns: auto auto;
    align-items: center;
    column-gap: 0.55rem;
  }
  .now-pulse {
    width: 10px;
    height: 10px;
    background: var(--note-bright);
    box-shadow: 0 0 0 3px var(--note-tint);
  }
  @media (prefers-reduced-motion: no-preference) {
    .now-pulse {
      animation: led 1.2s steps(1, end) infinite;
    }
  }
  @keyframes led {
    50% {
      background: var(--note);
      box-shadow: 0 0 0 3px transparent;
    }
  }
  .now-label {
    font-family: var(--font-pixel);
    font-weight: 800;
    font-size: 1.35rem;
    line-height: 1;
    color: var(--ink);
    white-space: nowrap;
  }
  .now-date {
    grid-column: 2;
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--ink-3);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .now-text {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    padding-left: var(--space-l);
    font-size: 0.95em;
    line-height: 1.6;
    background: linear-gradient(var(--line-strong) 50%, transparent 0) left top / 2px 6px repeat-y;
  }
  .now-more {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--accent);
    font-family: var(--font-pixel);
    font-weight: 700;
    font-size: 1.15rem;
    white-space: nowrap;
  }

  /* "Mới viết": bài dẫn + danh sách gọn */
  .latest {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: var(--space-xl);
    align-items: stretch;
  }
  .latest-list {
    display: grid;
    gap: var(--space-s);
  }
  .latest-list > :global(.v-compact + .explore) {
    margin-top: var(--space-s);
  }
  .explore {
    display: grid;
    gap: var(--space-s);
    align-content: start;
    margin: var(--pu);
    padding: var(--card-pad);
    background:
      repeating-linear-gradient(-45deg, transparent 0 10px, var(--accent-tint) 10px 12px),
      color-mix(in srgb, var(--bg-elev) 80%, transparent);
  }
  .explore h3 {
    font-size: var(--step-2);
    line-height: 1;
  }
  .explore-lead {
    color: var(--ink-2);
    font-size: 0.95em;
    line-height: 1.6;
  }
  .explore-links {
    list-style: none;
    padding: var(--space-s) 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1.25rem;
    background: linear-gradient(90deg, var(--line-strong) 50%, transparent 0) top left / 8px 2px repeat-x;
  }
  .explore-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-pixel);
    font-weight: 700;
    font-size: 1.2rem;
    text-decoration: none;
  }
  .explore-links a:hover {
    text-decoration: underline;
    text-decoration-thickness: 3px;
  }

  .work-stack {
    display: grid;
    gap: var(--space-xl);
  }
  .work-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: var(--space-xl);
  }

  @media (max-width: 1060px) {
    .latest {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 960px) {
    .hero {
      grid-template-columns: 1fr;
    }
    .hero-art {
      width: 100%;
      max-width: 36rem;
    }
  }
  @media (max-width: 720px) {
    .now-card {
      grid-template-columns: minmax(0, 1fr);
    }
    .now-head {
      grid-template-columns: auto auto 1fr;
    }
    .now-date {
      grid-column: 3;
    }
    .now-text {
      padding-left: 0;
      background: none;
    }
  }
  @media (max-width: 420px) {
    .bubble {
      display: none;
    }
  }
</style>
