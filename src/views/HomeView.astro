---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Icon from '~/components/Icon.astro';
import MiniConstellation from '~/components/MiniConstellation.astro';
import EntryCard from '~/components/EntryCard.astro';
import WorkCard from '~/components/WorkCard.astro';
import JourneyStrip from '~/components/JourneyStrip.astro';
import Empty from '~/components/Empty.astro';
import Mascot from '~/components/Mascot.astro';
import { getGraph } from '~/lib/graph';
import { SITE } from '~/site.config';
import { formatDate, sectionUrl, t, type Lang } from '~/i18n/utils';
import { getListing, getMilestones, getNowEntries, plainExcerpt } from '~/lib/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);

const stories = await getListing('stories', lang);
const latestStories = [...stories.primary, ...stories.fallback].sort((a, b) => b.date.getTime() - a.date.getTime()).slice(0, 3);
const work = await getListing('work', lang);
const allWork = [...work.primary, ...work.fallback];
const featuredWork = [...allWork.filter((w) => w.featured), ...allWork.filter((w) => !w.featured)].slice(0, 3);
const notes = await getListing('notes', lang);
const latestNotes = [...notes.primary, ...notes.fallback].sort((a, b) => b.sortDate.getTime() - a.sortDate.getTime()).slice(0, 4);
const milestones = await getMilestones(lang);
const [now] = await getNowEntries(lang);
const starCount = (await getGraph(lang)).nodes.length;

const jsonLd = [
  {
    '@type': 'WebSite',
    name: SITE.name,
    url: new URL(sectionUrl('home', lang), Astro.site).href,
    inLanguage: lang,
    description: SITE.description[lang],
  },
  {
    '@type': 'Person',
    name: SITE.fullName,
    alternateName: SITE.author,
    jobTitle: SITE.role[lang],
    homeLocation: SITE.location[lang],
    url: new URL(sectionUrl('about', lang), Astro.site).href,
    sameAs: SITE.socials.map((s) => s.href),
  },
];
const alternates = { vi: sectionUrl('home', 'vi'), en: sectionUrl('home', 'en') };
---

<BaseLayout lang={lang} alternates={alternates} jsonLd={jsonLd} mainClass="home">
  <section class="hero container">
    <div class="hero-text">
      <p class="eyebrow"><span class="glyph">✦</span> {tr('home.eyebrow')}</p>
      <h1 class="title-pop">{tr('home.hello')}</h1>
      <div class="dialogue px">
        <p class="nameplate"><span>{SITE.author}</span> <span class="np-role">{SITE.role[lang]}</span></p>
        <p class="lead">{tr('home.lead')}</p>
        <span class="dlg-next" aria-hidden="true"></span>
      </div>
      <div class="hero-cta">
        <a class="btn btn-primary" href={sectionUrl('stories', lang)}>{tr('home.ctaStories')} <Icon name="arrow-right" /></a>
        <a class="btn" href={sectionUrl('universe', lang)}><Icon name="map" /> {tr('home.ctaUniverse')}</a>
      </div>
    </div>
    <div class="hero-art">
      <div class="screen px">
        <p class="screen-bar" aria-hidden="true">
          <span class="sb-title"><span class="glyph">✦</span> {tr('home.mapWindow')}</span>
          <span class="sb-count">{starCount} {tr('home.stars')}</span>
          <span class="sb-dots"><i></i><i></i><i></i></span>
        </p>
        <div class="screen-body">
          <MiniConstellation lang={lang} />
        </div>
      </div>
      <div class="curio" aria-hidden="true">
        <Mascot size={92} />
        <p class="bubble">{tr('home.mascotHint')}</p>
      </div>
    </div>
  </section>

  {
    now && (
      <section class="container now-strip" aria-labelledby="now-title">
        <a href={sectionUrl('now', lang)} class="now-card px px-lift">
          <span class="now-pulse" aria-hidden="true" />
          <span class="now-label" id="now-title">
            {tr('home.now')}{' '}
            <time datetime={now.entry.data.date.toISOString()}>· {formatDate(now.entry.data.date, lang)}</time>
          </span>
          <span class="now-text">{plainExcerpt(now.entry.body ?? '', 200)}</span>
          <span class="now-more">
            {tr('home.nowMore')} <Icon name="arrow-right" />
          </span>
        </a>
      </section>
    )
  }

  <section class="container block" aria-labelledby="h-stories">
    <div class="section-head">
      <div>
        <p class="eyebrow"><span class="num">01</span> {tr('nav.stories')}</p>
        <h2 id="h-stories">{tr('home.latestStories')}</h2>
      </div>
      <a class="more" href={sectionUrl('stories', lang)}>{tr('home.seeAll')} <Icon name="arrow-right" /></a>
    </div>
    {
      latestStories.length ? (
        <div class="grid-3">
          {latestStories.map((item) => (
            <EntryCard item={item} lang={lang} />
          ))}
        </div>
      ) : (
        <Empty lang={lang} />
      )
    }
  </section>

  <section class="container block" aria-labelledby="h-work">
    <div class="section-head">
      <div>
        <p class="eyebrow"><span class="num">02</span> {tr('nav.work')}</p>
        <h2 id="h-work">{tr('home.featuredWork')}</h2>
      </div>
      <a class="more" href={sectionUrl('work', lang)}>{tr('home.seeAll')} <Icon name="arrow-right" /></a>
    </div>
    {
      featuredWork.length ? (
        <div class="work-stack">
          {featuredWork.map((item, i) => (
            <WorkCard item={item} lang={lang} size={i === 0 ? 'large' : 'normal'} />
          ))}
        </div>
      ) : (
        <Empty lang={lang} />
      )
    }
  </section>

  {
    milestones.length > 0 && (
      <section class="container block" aria-labelledby="h-journey">
        <div class="section-head">
          <div>
            <p class="eyebrow"><span class="num">03</span> {tr('nav.journey')}</p>
            <h2 id="h-journey">{tr('home.journey')}</h2>
          </div>
          <a class="more" href={sectionUrl('journey', lang)}>
            {tr('home.journeyMore')} <Icon name="arrow-right" />
          </a>
        </div>
        <JourneyStrip milestones={milestones} lang={lang} />
      </section>
    )
  }

  <section class="container block" aria-labelledby="h-notes">
    <div class="section-head">
      <div>
        <p class="eyebrow"><span class="num">04</span> {tr('nav.notes')}</p>
        <h2 id="h-notes">{tr('home.notes')}</h2>
      </div>
      <a class="more" href={sectionUrl('notes', lang)}>{tr('home.seeAll')} <Icon name="arrow-right" /></a>
    </div>
    {
      latestNotes.length ? (
        <div class="notes-list">
          {latestNotes.map((item) => (
            <EntryCard item={item} lang={lang} variant="row" />
          ))}
        </div>
      ) : (
        <Empty lang={lang} />
      )
    }
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    align-items: center;
    gap: clamp(2rem, 4vw, 3.5rem);
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(2rem, 4vw, 3rem);
  }
  .hero h1 {
    font-size: clamp(3.4rem, 2rem + 5.2vw, 6.6rem);
    line-height: 0.95;
    letter-spacing: 0.005em;
    margin-block: var(--space-m) var(--space-xl);
    font-weight: 800;
  }

  /* Hộp thoại kiểu visual novel */
  .dialogue {
    --s: calc(var(--pu) * 2);
    position: relative;
    max-width: 36rem;
    padding: 1.6rem 1.4rem 1.3rem;
    margin: 0 var(--pu);
    background: color-mix(in srgb, var(--bg-elev) 94%, transparent);
  }
  .nameplate {
    --pu: 2px;
    position: absolute;
    top: -1.05rem;
    left: 1rem;
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.1rem 0.7rem 0.15rem;
    background: var(--ink);
    color: var(--bg-elev);
    font-family: var(--font-pixel);
    font-weight: 800;
    font-size: 1.3rem;
    line-height: 1.2;
    letter-spacing: 0.04em;
  }
  .np-role {
    font-family: var(--font-hud);
    font-weight: 400;
    font-size: 1.05rem;
    color: var(--pop-soft);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  :global(:root[data-theme='dark']) .nameplate {
    background: var(--frame);
    color: #120f33;
  }
  :global(:root[data-theme='dark']) .np-role {
    color: #3a1450;
  }
  .hero .lead {
    font-size: var(--step-1);
    color: var(--ink);
    line-height: 1.7;
  }
  .dlg-next {
    position: absolute;
    right: 0.9rem;
    bottom: 0.55rem;
    width: 12px;
    height: 8px;
    background: var(--pop);
    clip-path: polygon(0 0, 100% 0, 100% 25%, 83% 25%, 83% 50%, 67% 50%, 67% 75%, 50% 75%, 50% 100%, 50% 100%, 33% 75%, 33% 50%, 17% 50%, 17% 25%, 0 25%);
  }
  @media (prefers-reduced-motion: no-preference) {
    .dlg-next {
      animation: dlg-bounce 0.9s steps(1, end) infinite;
    }
  }
  @keyframes dlg-bounce {
    50% {
      transform: translateY(3px);
    }
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: var(--space-xl);
  }

  /* Cửa sổ "màn hình game" chứa chòm sao */
  .hero-art {
    position: relative;
    padding: 0 var(--pu) var(--space-l);
  }
  .screen {
    --s: calc(var(--pu) * 3);
    background: var(--bg-elev);
  }
  .screen-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.35rem 0.75rem 0.4rem;
    background: var(--ink);
    color: var(--bg-elev);
    font-family: var(--font-hud);
    font-size: 1.15rem;
    line-height: 1.2;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  :global(:root[data-theme='dark']) .screen-bar {
    background: var(--frame);
    color: #120f33;
  }
  .sb-title {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }
  .sb-title .glyph {
    background: var(--star-bright);
  }
  .sb-count {
    opacity: 0.75;
  }
  .sb-dots {
    margin-left: auto;
    display: inline-flex;
    gap: 5px;
  }
  .sb-dots i {
    width: 9px;
    height: 9px;
    background: var(--pop);
  }
  .sb-dots i:nth-child(2) {
    background: var(--star-bright);
  }
  .sb-dots i:nth-child(3) {
    background: var(--note-bright);
  }
  .screen-body {
    padding: 0.5rem;
    background:
      linear-gradient(var(--sky-grid) 1px, transparent 1px) 0 0 / 16px 16px,
      linear-gradient(90deg, var(--sky-grid) 1px, transparent 1px) 0 0 / 16px 16px,
      linear-gradient(to bottom, color-mix(in srgb, var(--sky-2) 35%, var(--bg-elev)), var(--bg-elev));
  }
  :global(:root[data-theme='dark']) .screen-body {
    background:
      linear-gradient(var(--sky-grid) 1px, transparent 1px) 0 0 / 16px 16px,
      linear-gradient(90deg, var(--sky-grid) 1px, transparent 1px) 0 0 / 16px 16px,
      linear-gradient(to bottom, #0a0722, #1a1048 70%, #2a1660);
  }
  .curio {
    position: absolute;
    left: -1.9rem;
    bottom: -0.4rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    pointer-events: none;
  }
  .bubble {
    --pu: 2px;
    --frame: var(--ink);
    --s: 0px;
    position: relative;
    margin: 0 0 1.4rem 0.4rem;
    padding: 0.2rem 0.6rem 0.25rem;
    background: var(--bg-elev);
    color: var(--ink);
    font-family: var(--font-pixel);
    font-weight: 600;
    font-size: 1.1rem;
    line-height: 1.25;
    white-space: nowrap;
    box-shadow:
      0 -2px 0 0 var(--frame),
      0 2px 0 0 var(--frame),
      -2px 0 0 0 var(--frame),
      2px 0 0 0 var(--frame);
  }
  /* đuôi bong bóng thoại chỉ về phía Curio */
  .bubble::after {
    content: '';
    position: absolute;
    left: -11px;
    bottom: 2px;
    width: 10px;
    height: 10px;
    background: var(--frame);
    clip-path: polygon(100% 0, 100% 100%, 0 100%, 0 80%, 20% 80%, 20% 60%, 40% 60%, 40% 40%, 60% 40%, 60% 20%, 80% 20%, 80% 0);
  }
  @media (prefers-reduced-motion: no-preference) {
    .bubble {
      animation: bubble-pop 6s steps(1, end) infinite;
    }
  }
  @keyframes bubble-pop {
    0%,
    8% {
      opacity: 0;
    }
    9%,
    70% {
      opacity: 1;
    }
    71%,
    100% {
      opacity: 0;
    }
  }

  /* Dải "Bây giờ" — như thông báo trong game */
  .now-strip {
    margin-bottom: var(--space-2xl);
  }
  .now-card {
    --s: calc(var(--pu) * 2);
    display: grid;
    grid-template-columns: auto auto 1fr auto;
    align-items: center;
    gap: var(--space-m);
    margin: 0 var(--pu);
    padding: 0.8rem var(--space-l);
    background: var(--bg-elev);
    color: var(--ink-2);
    text-decoration: none;
  }
  .now-card:hover {
    color: var(--ink-2);
  }
  .now-pulse {
    width: 12px;
    height: 12px;
    background: var(--note-bright);
    box-shadow: 0 0 0 3px var(--note-tint);
  }
  @media (prefers-reduced-motion: no-preference) {
    .now-pulse {
      animation: led 1.2s steps(1, end) infinite;
    }
  }
  @keyframes led {
    50% {
      background: var(--note);
      box-shadow: 0 0 0 3px transparent;
    }
  }
  .now-label {
    font-family: var(--font-pixel);
    font-weight: 700;
    font-size: 1.3rem;
    line-height: 1;
    color: var(--ink);
    white-space: nowrap;
  }
  .now-label time {
    font-family: var(--font-hud);
    font-weight: 400;
    font-size: 1.1rem;
    color: var(--ink-3);
  }
  .now-text {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0;
  }
  .now-more {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--accent);
    font-family: var(--font-pixel);
    font-weight: 700;
    font-size: 1.15rem;
    white-space: nowrap;
  }

  .block {
    margin-top: var(--space-4xl);
  }
  .home > .block:first-of-type {
    margin-top: var(--space-2xl);
  }
  .eyebrow .num {
    display: inline-grid;
    place-items: center;
    min-width: 2.1em;
    padding: 0 0.3em;
    background: var(--ink);
    color: var(--bg-elev);
    letter-spacing: 0.04em;
  }
  .grid-3 {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: var(--space-xl);
  }
  .work-stack {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
  }
  .work-stack > :global(:first-child) {
    grid-column: 1 / -1;
  }
  .notes-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 30rem), 1fr));
    column-gap: var(--space-2xl);
  }

  @media (max-width: 960px) {
    .hero {
      grid-template-columns: 1fr;
    }
    .hero-art {
      max-width: 34rem;
      margin-inline: auto;
      width: 100%;
    }
    .curio {
      left: -0.6rem;
    }
    .work-stack {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 720px) {
    .now-card {
      grid-template-columns: auto 1fr;
      row-gap: 0.4rem;
    }
    .now-text {
      grid-column: 1 / -1;
      white-space: normal;
    }
    .now-more {
      grid-column: 1 / -1;
    }
  }
</style>
