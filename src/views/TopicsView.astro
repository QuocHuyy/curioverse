---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHead from './PageHead.astro';
import Empty from '~/components/Empty.astro';
import { sectionUrl, t, type Lang } from '~/i18n/utils';
import { getTags } from '~/lib/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);
const tags = await getTags(lang);
const max = Math.max(1, ...tags.map((x) => x.count));
---

<BaseLayout
  lang={lang}
  title={tr('topics.title')}
  description={tr('topics.lead')}
  alternates={{ vi: sectionUrl('topics', 'vi'), en: sectionUrl('topics', 'en') }}
>
  <PageHead lang={lang} eyebrow={tr('nav.topics')} title={tr('topics.title')} lead={tr('topics.lead')} seed="topics" />
  <div class="container">
    {
      tags.length ? (
        <ul class="cloud">
          {tags.map((x) => (
            <li style={`--w:${0.4 + (x.count / max) * 0.6}`}>
              <a class="px px-lift" href={sectionUrl('topics', lang, x.slug)}>
                <span class="name">#{x.tag}</span>
                <span class="count">
                  {x.count} {tr('topics.entries')}
                </span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <Empty lang={lang} />
      )
    }
  </div>
</BaseLayout>

<style>
  .cloud {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .cloud a {
    --frame: var(--ink);
    --hard: var(--pop);
    --s: 4px;
    display: inline-flex;
    align-items: baseline;
    gap: 0.6rem;
    margin: var(--pu);
    padding: 0.45rem 0.9rem 0.5rem;
    background: var(--bg-elev);
    text-decoration: none;
    color: var(--ink);
  }
  :global(:root[data-theme='dark']) .cloud a {
    --hard: #05031a;
  }
  .cloud li:nth-child(3n + 2) a {
    --hard: var(--work-bright);
  }
  .cloud li:nth-child(3n + 3) a {
    --hard: var(--note-bright);
  }
  :global(:root[data-theme='dark']) .cloud li a {
    --hard: #05031a;
  }
  .name {
    font-family: var(--font-display);
    font-weight: 700;
    line-height: 1;
    font-size: calc(var(--step-0) * (1.1 + var(--w) * 0.9));
  }
  .count {
    font-family: var(--font-hud);
    font-size: 1.05rem;
    color: var(--ink-3);
  }
</style>
