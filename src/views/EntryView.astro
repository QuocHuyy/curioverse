---
/** Trang chi tiết dùng chung cho Câu chuyện, Công việc và Ghi chép. */
import { render } from 'astro:content';
// CSS của KaTeX (~23KB + font) chỉ nạp ở bài có công thức toán, không nạp cho mọi bài
import katexCss from 'katex/dist/katex.min.css?url';
import '~/styles/prose.css';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Sigil from '~/components/Sigil.astro';
import Icon from '~/components/Icon.astro';
import Toc from '~/components/Toc.astro';
import TagList from '~/components/TagList.astro';
import StageBadge from '~/components/StageBadge.astro';
import EntryCard from '~/components/EntryCard.astro';
import ReadingProgress from '~/components/ReadingProgress.astro';
import { mdxComponents } from '~/components/mdx';
import { SITE } from '~/site.config';
import { formatDate, sectionUrl, t, url } from '~/i18n/utils';
import { formatPeriod } from '~/lib/format';
import { getBacklinks, getNeighbors, getRelated, getSeries, getTranslation, type Item, type WorkData } from '~/lib/content';

interface Props {
  item: Item;
}
const { item } = Astro.props;
const lang = item.lang;
const tr = t(lang);
const { Content, headings, remarkPluginFrontmatter } = await render(item.entry);
const translation = await getTranslation(item);
const alternates = { [lang]: item.url, ...(translation ? { [translation.lang]: translation.url } : {}) };
const backlinks = await getBacklinks(item);
const series = await getSeries(item);
// Không lặp lại ở "Có thể bạn sẽ thích" những bài đã có trong "Được nhắc đến trong" hay khung series
const related = await getRelated(item, new Set([...backlinks, ...series].map((b) => b.key)));
const { prev, next } = await getNeighbors(item);
const seriesIndex = series.findIndex((s) => s.id === item.id);
const d = item.entry.data as any;
const wd = item.entry.data as WorkData;
const kindLabel = tr(`kind.${item.kind}.one`);
const sectionLabel = tr(`kind.${item.kind}`);
const og = url(`/og/${item.kind}/${item.lang}/${item.slug}.png`);
const editUrl = item.entry.filePath ? `${SITE.repo}/edit/${SITE.repoBranch}/${item.entry.filePath}` : SITE.repo;
const period = item.kind === 'work' ? formatPeriod(d, lang) : '';
const links = item.kind === 'work' ? (['repo', 'demo', 'paper'] as const).filter((k) => d.links?.[k]) : [];
const linkIcons = { repo: 'github', demo: 'globe', paper: 'paper' } as const;
// Do plugins/remark-has-math.mjs đánh dấu khi bài có công thức
const hasMath = Boolean(remarkPluginFrontmatter?.hasMath);

// Với dự án, `updated` là ngày kết thúc dự án chứ không phải ngày sửa bài → không dùng làm "modified"
const modified = item.kind === 'work' ? undefined : item.updated;

const jsonLd = {
  '@type': item.kind === 'work' ? 'CreativeWork' : 'BlogPosting',
  headline: item.title,
  description: item.description,
  inLanguage: lang,
  datePublished: item.published.toISOString(),
  dateModified: (modified ?? item.published).toISOString(),
  url: new URL(item.url, Astro.site).href,
  image: new URL(og, Astro.site).href,
  keywords: item.tags.join(', '),
  author: { '@type': 'Person', name: SITE.fullName, url: new URL(sectionUrl('about', lang), Astro.site).href },
};
---

<BaseLayout
  lang={lang}
  title={item.title}
  description={item.description}
  image={og}
  type="article"
  alternates={alternates}
  published={item.published}
  modified={modified}
  tags={item.tags}
  jsonLd={jsonLd}
>
  {hasMath && <link slot="head" rel="stylesheet" href={katexCss} />}
  <ReadingProgress />
  <article class="entry" data-kind={item.kind} data-pagefind-body data-pagefind-meta={`kind:${kindLabel}`}>
    <span data-pagefind-meta={`kindId:${item.kind}`}></span>
    <header class="entry-head">
      <div class="entry-col head-inner">
        <div class="entry-art sky-window px-soft" aria-hidden="true"><Sigil seed={item.key} chart twinkle /></div>
        <a class="crumb" href={sectionUrl(item.kind, lang)} data-pagefind-ignore><Icon name="arrow-left" /> {sectionLabel}</a>
        <p class="entry-eyebrow" data-pagefind-ignore>
          <span class="entry-sigil sigil-chip sky-window" aria-hidden="true"><Sigil seed={item.key} twinkle /></span>
          <span class="kind-tag">{kindLabel}</span>
          {item.stage && <StageBadge stage={item.stage} lang={lang} showDesc />}
          {item.kind === 'work' && <span class="cat">{tr(`category.${wd.category}`)}</span>}
          {item.draft && <span class="badge-draft">{tr('meta.draft')}</span>}
        </p>
        <h1 class="title-pop">{item.title}</h1>
        <p class="lead">{item.description}</p>
        <p class="meta entry-meta" data-pagefind-ignore>
          {
            item.kind === 'notes' ? (
              <>
                <span>
                  {tr('meta.planted')} <time datetime={item.date.toISOString()}>{formatDate(item.date, lang)}</time>
                </span>
                {item.updated && (
                  <span>
                    {tr('meta.tended')} <time datetime={item.updated.toISOString()}>{formatDate(item.updated, lang)}</time>
                  </span>
                )}
              </>
            ) : item.kind === 'work' ? (
              <span>
                <Icon name="calendar" size="12" /> {period}
              </span>
            ) : (
              <>
                <span>
                  <Icon name="calendar" size="12" /> <time datetime={item.date.toISOString()}>{formatDate(item.date, lang)}</time>
                </span>
                {item.updated && (
                  <span>
                    {tr('meta.updated')} <time datetime={item.updated.toISOString()}>{formatDate(item.updated, lang)}</time>
                  </span>
                )}
              </>
            )
          }
          <span><Icon name="clock" size="12" /> {item.readingMinutes} {tr('meta.minRead')}</span>
          {d.series && series.length < 2 && <span><Icon name="list" size="12" /> {tr('meta.series')}: {d.series}</span>}
          {
            translation && (
              <a class="translation" href={translation.url} hreflang={translation.lang} lang={translation.lang}>
                <Icon name="language" size="12" /> {t(translation.lang)('lang.name')}
              </a>
            )
          }
        </p>

        {
          series.length > 1 && (
            <nav class="series px-flat" aria-label={`${tr('meta.series')}: ${d.series}`} data-pagefind-ignore>
              <p class="series-head">
                <Icon name="list" size="12" /> {tr('meta.series')} · <strong>{d.series}</strong>
                <span class="series-pos">
                  {tr('meta.part')} {seriesIndex + 1}/{series.length}
                </span>
              </p>
              <ol>
                {series.map((s) => (
                  <li>
                    {s.id === item.id ? (
                      <span aria-current="page">{s.title}</span>
                    ) : (
                      <a href={s.url}>{s.title}</a>
                    )}
                  </li>
                ))}
              </ol>
            </nav>
          )
        }

        {
          item.kind === 'work' && (
            <div class:list={['work-meta', 'px', { split: d.highlights?.length > 0 }]} data-pagefind-ignore>
              <p class="win-bar" aria-hidden="true">
                <span class="glyph">✦</span> {tr('meta.status')} · {kindLabel}
                <span class="win-dots"><i></i><i></i><i></i></span>
              </p>
              <div class="wm-main">
              <dl>
                <div>
                  <dt>{tr('meta.role')}</dt>
                  <dd>{d.role}</dd>
                </div>
                <div>
                  <dt>{tr('meta.status')}</dt>
                  <dd>{tr(`status.${wd.status}`)}</dd>
                </div>
                {d.stack?.length > 0 && (
                  <div class="wide">
                    <dt>{tr('meta.stack')}</dt>
                    <dd>
                      <ul class="stack">
                        {d.stack.map((s: string) => (
                          <li>{s}</li>
                        ))}
                      </ul>
                    </dd>
                  </div>
                )}
              </dl>
              {links.length > 0 && (
                <div class="work-links">
                  {links.map((k) => (
                    <a class="btn" href={d.links[k]} rel="noopener">
                      <Icon name={linkIcons[k]} /> {tr(`link.${k}`)} <Icon name="arrow-up-right" />
                    </a>
                  ))}
                </div>
              )}
              </div>
              {d.highlights?.length > 0 && (
                <div class="highlights">
                  <p class="hl-title">{tr('meta.highlights')}</p>
                  <ul>
                    {d.highlights.map((h: string) => (
                      <li>{h}</li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          )
        }
      </div>
    </header>

    <div class="entry-layout">
      <aside class="entry-toc"><div class="toc-sticky"><Toc headings={headings} lang={lang} /></div></aside>
      <div class="prose entry-content">
        <Content components={mdxComponents} />
      </div>
    </div>

    <footer class="entry-foot entry-col" data-pagefind-ignore>
      <TagList tags={item.tags} lang={lang} />
      <div class="foot-actions">
        <button class="btn" type="button" data-copy-link data-copied={tr('entry.copied')}>
          <Icon name="link" /> <span>{tr('entry.copy')}</span>
        </button>
        <a class="btn" href={url(lang === 'en' ? '/en/rss.xml' : '/rss.xml')}><Icon name="rss" /> {tr('entry.follow')}</a>
        <a class="edit" href={editUrl} rel="noopener"><Icon name="edit" /> {tr('entry.edit')}</a>
      </div>

      {
        backlinks.length > 0 && (
          <section class="foot-section">
            <h2>{tr('entry.backlinks')}</h2>
            <div class="foot-list">
              {backlinks.map((b) => (
                <EntryCard item={b} lang={lang} variant="compact" showKind />
              ))}
            </div>
          </section>
        )
      }
      {
        related.length > 0 && (
          <section class="foot-section">
            <h2>{tr('entry.related')}</h2>
            <div class="foot-list">
              {related.map((r) => (
                <EntryCard item={r} lang={lang} variant="compact" showKind />
              ))}
            </div>
          </section>
        )
      }
      {
        (prev || next) && (
          <nav class="prev-next" aria-label={`${tr('entry.prev')} / ${tr('entry.next')}`}>
            {prev ? (
              <a href={prev.url} class="pn prev px-soft px-lift">
                <span>
                  <Icon name="arrow-left" /> {tr('entry.prev')}
                </span>
                <strong>{prev.title}</strong>
              </a>
            ) : (
              <span />
            )}
            {next && (
              <a href={next.url} class="pn next px-soft px-lift">
                <span>
                  {tr('entry.next')} <Icon name="arrow-right" />
                </span>
                <strong>{next.title}</strong>
              </a>
            )}
          </nav>
        )
      }
    </footer>
  </article>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-link]').forEach((btn) =>
    btn.addEventListener('click', async () => {
      const label = btn.querySelector('span');
      const original = label?.textContent;
      try {
        await navigator.clipboard.writeText(location.href.split('#')[0]);
        if (label) label.textContent = btn.dataset.copied ?? '✓';
        setTimeout(() => label && original && (label.textContent = original), 1800);
      } catch {}
    }),
  );
</script>

<style>
  .entry {
    /* Cột đọc: tiêu đề, nội dung, chân bài cùng thẳng một mép */
    --col: 42rem;
    --rail: 12rem;
    --rail-gap: 3rem;
  }
  .entry-col {
    width: min(100% - 2 * var(--gutter), var(--col));
    margin-inline: auto;
  }
  .entry-head {
    position: relative;
    padding-block: clamp(1.75rem, 4.5vw, 3.5rem) var(--space-xl);
  }
  .head-inner {
    position: relative;
  }
  /* Chòm sao của bài: ô nhỏ cạnh nhãn; màn hình rộng thì thành cửa sổ ở lề phải */
  .entry-art {
    display: none;
  }
  .entry-sigil {
    width: 2.5rem;
    height: 2.5rem;
    padding: 4px;
  }
  .crumb {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-pixel);
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--ink-3);
    text-decoration: none;
    margin-bottom: var(--space-l);
  }
  .crumb:hover {
    color: var(--accent);
  }
  .crumb :global(.icon) {
    transition: transform 120ms var(--ease-px);
  }
  .crumb:hover :global(.icon) {
    transform: translateX(-3px);
  }
  .entry-eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.75rem;
  }
  .cat {
    font-family: var(--font-label);
    font-size: 1.08rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  h1 {
    font-size: clamp(2.5rem, 1.6rem + 3.4vw, 4.4rem);
    line-height: 1;
    margin-block: var(--space-m) var(--space-l);
  }
  .entry-meta {
    margin-top: var(--space-l);
  }
  .translation {
    color: var(--accent);
    text-decoration: none;
  }
  .translation:hover {
    text-decoration: underline;
  }

  /* Các phần của một series */
  .series {
    margin: var(--space-xl) var(--pu) 0;
    padding: var(--space-m) var(--card-pad);
    background: var(--bg-elev);
  }
  .series-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-label);
    font-size: 1.05rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .series-head strong {
    color: var(--ink);
    font-weight: 400;
  }
  .series-pos {
    margin-left: auto;
  }
  .series ol {
    margin: var(--space-s) 0 0;
    padding-left: 1.6em;
    display: grid;
    gap: 0.3rem;
    font-size: 0.95em;
  }
  .series [aria-current] {
    font-weight: 700;
    color: var(--accent);
  }

  /* Cửa sổ "trạng thái" kiểu RPG cho dự án */
  .work-meta {
    --s: calc(var(--pu) * 2);
    --hard: var(--work-bright);
    margin: var(--space-xl) var(--pu) 0;
    display: grid;
    background: var(--bg-elev);
  }
  :global(:root[data-theme='dark']) .work-meta {
    --hard: #05031a;
  }
  .work-meta .win-bar {
    grid-column: 1 / -1;
  }
  .wm-main,
  .highlights {
    display: grid;
    gap: var(--space-l);
    align-content: start;
    padding: var(--card-pad);
  }
  .work-meta dl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-m) var(--space-l);
  }
  .work-meta .wide {
    grid-column: 1 / -1;
  }
  dt {
    font-family: var(--font-label);
    font-size: 1.05rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 0.15rem;
  }
  dd {
    margin: 0;
    font-weight: 700;
    line-height: 1.5;
  }
  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
    padding: 0;
  }
  .stack li {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 400;
    line-height: 1.6;
    padding: 0.05em 0.55em;
    background: var(--work-tint);
    color: var(--ink-2);
    box-shadow: inset 0 -2px 0 color-mix(in srgb, var(--work-bright) 45%, transparent);
  }
  .work-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .highlights {
    gap: 0.4rem;
    background: linear-gradient(90deg, var(--line-strong) 50%, transparent 0) top left / 8px 2px repeat-x;
  }
  .hl-title {
    font-family: var(--font-label);
    font-size: 1.05rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .highlights ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.45rem;
    font-size: 0.95em;
    line-height: 1.55;
  }
  .highlights li {
    position: relative;
    padding-left: 1.3em;
  }
  .highlights li::before {
    content: '';
    position: absolute;
    left: 0.1em;
    top: 0.5em;
    width: 0.6em;
    height: 0.6em;
    background: var(--work-bright);
    clip-path: var(--clip-gem);
  }
  @media (min-width: 760px) {
    .work-meta.split {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    }
    .work-meta.split dl {
      grid-template-columns: 1fr;
    }
    .work-meta.split .highlights {
      background: linear-gradient(var(--line-strong) 50%, transparent 0) top left / 2px 8px repeat-y;
    }
  }

  .entry-layout {
    width: min(100% - 2 * var(--gutter), var(--col));
    margin-inline: auto;
    display: grid;
    gap: var(--space-xl);
  }
  .entry-content {
    min-width: 0;
    max-width: none;
  }
  @media (min-width: 1180px) {
    .entry-layout {
      width: auto;
      grid-template-columns: var(--rail) minmax(0, var(--col)) var(--rail);
      justify-content: center;
      column-gap: var(--rail-gap);
    }
    .toc-sticky {
      position: sticky;
      top: calc(var(--header-h) + 2.5rem);
      max-height: calc(100dvh - var(--header-h) - 4rem);
      overflow-y: auto;
      padding: 3px;
    }
    .entry-sigil {
      display: none;
    }
    .entry-art {
      --grid: 10px;
      display: block;
      position: absolute;
      top: 0.25rem;
      left: calc(100% + var(--rail-gap) + 3px);
      width: calc(var(--rail) - 6px);
      aspect-ratio: 1;
      padding: 12px;
    }
  }

  .entry-foot {
    margin-top: var(--space-3xl);
    padding-top: var(--space-xl);
    background: linear-gradient(90deg, var(--line-strong) 50%, transparent 0) top left / 8px 3px repeat-x;
    display: grid;
    gap: var(--space-xl);
  }
  .foot-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    align-items: center;
  }
  .edit {
    margin-left: auto;
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--ink-3);
    display: inline-flex;
    gap: 0.4rem;
    align-items: center;
  }
  .foot-section h2 {
    font-size: var(--step-2);
    margin-bottom: var(--space-m);
  }
  .foot-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-s) var(--space-m);
  }
  .prev-next {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-l);
  }
  .pn {
    display: grid;
    gap: 0.3rem;
    align-content: start;
    margin: var(--pu);
    padding: var(--space-m) var(--card-pad);
    text-decoration: none;
    color: var(--ink);
    background: var(--bg-elev);
  }
  .pn:hover {
    color: var(--ink);
  }
  .pn span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-label);
    font-size: 1.08rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .pn strong {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 700;
    line-height: 1.1;
  }
  .pn.next {
    text-align: right;
    justify-items: end;
    grid-column: 2;
  }
  @media (max-width: 560px) {
    .work-meta dl {
      grid-template-columns: 1fr;
    }
    .prev-next {
      grid-template-columns: 1fr;
    }
    .pn.next {
      grid-column: auto;
    }
    .edit {
      margin-left: 0;
    }
  }
</style>
