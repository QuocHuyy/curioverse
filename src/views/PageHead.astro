---
import type { Lang } from '~/i18n/utils';
import Sigil from '~/components/Sigil.astro';
interface Props {
  lang: Lang;
  eyebrow: string;
  title: string;
  lead?: string;
  seed?: string;
  kind?: string;
}
const { eyebrow, title, lead, seed, kind } = Astro.props;
---

<header class="page-head container" data-kind={kind}>
  <div class="ph-text">
    <p class="eyebrow"><span class="glyph">✦</span> {eyebrow}</p>
    <h1 class="title-pop">{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
  {
    seed && (
      <div class="ph-art sky-window px-soft" aria-hidden="true">
        <Sigil seed={seed} chart twinkle />
      </div>
    )
  }
</header>

<style>
  .page-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-xl);
    align-items: center;
  }
  .ph-text {
    min-width: 0;
  }
  .ph-art {
    --hard: var(--kind-bright, var(--pop));
    --grid: 10px;
    width: clamp(120px, 13vw, 176px);
    aspect-ratio: 1;
    margin: 0 8px 8px 0;
    padding: 12px;
  }
  @media (max-width: 640px) {
    .page-head {
      grid-template-columns: 1fr;
    }
    .ph-art {
      display: none;
    }
  }
</style>
