---
import type { Lang } from '~/i18n/utils';
import Sigil from '~/components/Sigil.astro';
interface Props {
  lang: Lang;
  eyebrow: string;
  title: string;
  lead?: string;
  seed?: string;
  kind?: string;
}
const { eyebrow, title, lead, seed, kind } = Astro.props;
---

<header class="page-head container" data-kind={kind}>
  <div class="ph-text">
    <p class="eyebrow"><span class="glyph">✦</span> {eyebrow}</p>
    <h1 class="title-pop">{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
  {
    seed && (
      <div class="ph-art px" aria-hidden="true">
        <Sigil seed={seed} chart twinkle />
      </div>
    )
  }
</header>

<style>
  .page-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-xl);
    align-items: center;
  }
  .ph-art {
    --hard: var(--kind-bright, var(--pop));
    --s: calc(var(--pu) * 3);
    width: clamp(130px, 17vw, 210px);
    aspect-ratio: 1;
    margin: 0 calc(var(--pu) * 4) calc(var(--pu) * 4) 0;
    padding: 12px;
    background:
      linear-gradient(var(--sky-grid) 1px, transparent 1px) 0 0 / 12px 12px,
      linear-gradient(90deg, var(--sky-grid) 1px, transparent 1px) 0 0 / 12px 12px,
      linear-gradient(to bottom, color-mix(in srgb, var(--sky-2) 40%, var(--bg-elev)), var(--bg-elev));
  }
  :global(:root[data-theme='dark']) .ph-art {
    --hard: #05031a;
    background:
      linear-gradient(var(--sky-grid) 1px, transparent 1px) 0 0 / 12px 12px,
      linear-gradient(90deg, var(--sky-grid) 1px, transparent 1px) 0 0 / 12px 12px,
      linear-gradient(to bottom, #0a0722, #1d1250 75%, #2e1863);
  }
  @media (max-width: 640px) {
    .page-head {
      grid-template-columns: 1fr;
    }
    .ph-art {
      display: none;
    }
  }
</style>
