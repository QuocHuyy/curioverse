---
import { render } from 'astro:content';
import '~/styles/prose.css';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHead from './PageHead.astro';
import Empty from '~/components/Empty.astro';
import { mdxComponents } from '~/components/mdx';
import { formatDate, sectionUrl, t, type Lang } from '~/i18n/utils';
import { getNowEntries } from '~/lib/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);
const entries = await getNowEntries(lang);
const rendered = await Promise.all(entries.map(async (e) => ({ ...e, ...(await render(e.entry)) })));
const [latest, ...archive] = rendered;
---

<BaseLayout
  lang={lang}
  title={tr('now.title')}
  description={tr('now.lead')}
  alternates={{ vi: sectionUrl('now', 'vi'), en: sectionUrl('now', 'en') }}
>
  <PageHead lang={lang} eyebrow={tr('nav.now')} title={tr('now.title')} lead={tr('now.lead')} seed="now-page" kind="notes" />
  <div class="container-narrow">
    {
      latest ? (
        <article class="latest px" data-pagefind-body data-pagefind-meta={`kind:${tr('nav.now')}`} lang={latest.lang}>
          <p class="stamp">
            <span class="dot" aria-hidden="true" /> {tr('now.updated')}{' '}
            <time datetime={latest.entry.data.date.toISOString()}>{formatDate(latest.entry.data.date, lang)}</time>
            {latest.entry.data.draft && <span class="badge-draft">{tr('meta.draft')}</span>}
          </p>
          <div class="prose">
            <latest.Content components={mdxComponents} />
          </div>
        </article>
      ) : (
        <Empty lang={lang} />
      )
    }

    {
      archive.length > 0 && (
        <section class="archive">
          <h2>{tr('now.archive')}</h2>
          {archive.map((e) => (
            <details>
              <summary>
                <time datetime={e.entry.data.date.toISOString()}>{formatDate(e.entry.data.date, lang, 'month')}</time>
              </summary>
              <div class="prose">
                <e.Content components={mdxComponents} />
              </div>
            </details>
          ))}
        </section>
      )
    }

    <p class="about-now">
      {tr('now.about')} <a href="https://nownownow.com/about" rel="noopener">nownownow.com</a>.
    </p>
  </div>
</BaseLayout>

<style>
  .latest {
    --s: calc(var(--pu) * 3);
    --hard: var(--note-bright);
    margin: var(--pu);
    padding: clamp(1.25rem, 1rem + 1.5vw, 2rem);
    background: var(--bg-elev);
  }
  :global(:root[data-theme='dark']) .latest {
    --hard: #05031a;
    --frame: var(--note-bright);
  }
  .stamp {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem;
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--ink-3);
    margin-bottom: var(--space-l);
  }
  .dot {
    width: 12px;
    height: 12px;
    background: var(--note-bright);
    box-shadow: 0 0 0 3px var(--note-tint);
  }
  @media (prefers-reduced-motion: no-preference) {
    .dot {
      animation: now-led 1.2s steps(1, end) infinite;
    }
  }
  @keyframes now-led {
    50% {
      background: var(--note);
    }
  }
  .archive {
    margin-top: var(--space-2xl);
  }
  .archive h2 {
    font-size: var(--step-3);
    margin-bottom: var(--space-m);
  }
  .archive details {
    padding-block: var(--space-m);
    background: linear-gradient(90deg, var(--line-strong) 50%, transparent 0) top left / 8px 3px repeat-x;
  }
  .archive summary {
    cursor: pointer;
    font-family: var(--font-pixel);
    font-size: 1.35rem;
    font-weight: 700;
  }
  .archive .prose {
    margin-top: var(--space-m);
    font-size: 0.95em;
  }
  .about-now {
    margin-top: var(--space-2xl);
    font-size: var(--step--1);
    color: var(--ink-3);
  }
</style>
