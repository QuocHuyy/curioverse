---
import BrandMark from './BrandMark.astro';
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
import LangSwitch from './LangSwitch.astro';
import { sectionUrl, stripBase, t, SECTIONS, type Lang, type Section } from '~/i18n/utils';
import { SITE } from '~/site.config';

interface Props {
  lang: Lang;
  langHref: string;
  langExact: boolean;
}
const { lang, langHref, langExact } = Astro.props;
const tr = t(lang);
const path = stripBase(Astro.url.pathname).replace(/\/$/, '');

const items: { section: Section; key: Parameters<typeof tr>[0] }[] = [
  { section: 'stories', key: 'nav.stories' },
  { section: 'work', key: 'nav.work' },
  { section: 'journey', key: 'nav.journey' },
  { section: 'notes', key: 'nav.notes' },
  { section: 'universe', key: 'nav.universe' },
  { section: 'about', key: 'nav.about' },
];
const isActive = (s: Section) => {
  const p = '/' + SECTIONS[s][lang];
  return path === p || path.startsWith(p + '/');
};
---

<header class="site-header" data-open="false">
  <div class="container bar px">
    <a class="brand" href={sectionUrl('home', lang)} aria-label={`${SITE.name} — ${tr('nav.home')}`}>
      <BrandMark />
      <span class="brand-name">{SITE.name}</span>
    </a>

    <nav class="nav px" id="site-nav" aria-label={tr('nav.primary')}>
      <ul>
        {
          items.map(({ section, key }) => (
            <li>
              <a href={sectionUrl(section, lang)} aria-current={isActive(section) ? 'page' : undefined}>
                {tr(key)}
              </a>
            </li>
          ))
        }
      </ul>
      <ul class="nav-extra">
        <li><a href={sectionUrl('now', lang)}>{tr('nav.now')}</a></li>
        <li><a href={sectionUrl('topics', lang)}>{tr('nav.topics')}</a></li>
      </ul>
    </nav>

    <div class="actions">
      <button class="icon-btn search-btn px-flat" type="button" data-search-open title={tr('search.open')}>
        <Icon name="search" size="18" />
        <span class="search-label">{tr('search.open')}</span>
        <kbd class="kbd" aria-hidden="true">⌘K</kbd>
      </button>
      <div class="prefs">
        <LangSwitch lang={lang} href={langHref} exact={langExact} />
        <span class="prefs-sep" aria-hidden="true"></span>
        <ThemeToggle lang={lang} />
      </div>
      <button
        class="icon-btn menu-btn"
        type="button"
        aria-controls="site-nav"
        aria-expanded="false"
        aria-label={tr('nav.menu')}
        data-label-open={tr('nav.menu')}
        data-label-close={tr('nav.close')}
      >
        <span class="mb-open"><Icon name="menu" size="22" /></span>
        <span class="mb-close"><Icon name="close" size="22" /></span>
      </button>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const btn = header?.querySelector<HTMLButtonElement>('.menu-btn');
  const setOpen = (open: boolean) => {
    if (!header || !btn) return;
    header.dataset.open = String(open);
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', (open ? btn.dataset.labelClose : btn.dataset.labelOpen) ?? '');
    document.documentElement.classList.toggle('nav-open', open);
  };
  btn?.addEventListener('click', () => setOpen(header?.dataset.open !== 'true'));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && header?.dataset.open === 'true') {
      setOpen(false);
      btn?.focus();
    }
  });
  matchMedia('(min-width: 1061px)').addEventListener('change', (e) => e.matches && setOpen(false));
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: calc(var(--header-h) + 0.75rem);
    padding-top: 0.75rem;
    pointer-events: none;
  }
  .bar {
    --s: calc(var(--pu) * 2);
    pointer-events: auto;
    height: var(--header-h);
    display: flex;
    align-items: center;
    gap: var(--space-l);
    padding-inline: 1rem 0.5rem;
    background: var(--bg-elev);
    transition: background-color 300ms var(--ease-out);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--ink);
    text-decoration: none;
    font-family: var(--font-pixel);
    font-weight: 800;
    font-size: 1.62rem;
    letter-spacing: 0.02em;
    line-height: 1;
    margin-right: auto;
  }
  .brand:hover {
    color: var(--ink);
  }
  @media (prefers-reduced-motion: no-preference) {
    .brand:hover :global(.brand-mark) {
      animation: brand-spin 0.6s steps(4, end);
    }
  }
  @keyframes brand-spin {
    to {
      transform: rotate(360deg);
    }
  }
  .nav ul {
    display: flex;
    align-items: center;
    gap: 0.1rem;
    list-style: none;
    padding: 0;
  }
  .nav a {
    position: relative;
    display: inline-block;
    padding: 0.3rem 0.55rem 0.35rem;
    color: var(--ink-2);
    font-family: var(--font-pixel);
    font-size: 1.24rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0.02em;
    text-decoration: none;
    white-space: nowrap;
  }
  .nav a:hover {
    color: var(--ink);
    background: var(--accent-tint);
  }
  .nav a[aria-current='page'] {
    color: var(--ink);
    box-shadow: inset 0 -4px 0 var(--pop);
  }
  .nav a[aria-current='page']::before {
    content: '';
    position: absolute;
    left: 50%;
    top: -0.45rem;
    width: 7px;
    height: 7px;
    margin-left: -3.5px;
    background: var(--star-bright);
    clip-path: var(--clip-gem);
  }
  .nav-extra {
    display: none !important;
  }
  @media (min-width: 1061px) {
    .nav {
      box-shadow: none;
    }
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }
  :global(.icon-btn) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.6rem;
    height: 2.6rem;
    padding: 0 0.6rem;
    color: var(--ink-2);
    font-family: var(--font-pixel);
    transition:
      background var(--dur),
      color var(--dur);
  }
  :global(.icon-btn:hover) {
    color: var(--ink);
    background: var(--accent-tint);
  }
  .search-btn {
    --frame: var(--line-strong);
    gap: 0.5rem;
    margin-inline: 0.25rem 0.5rem;
    padding-inline: 0.6rem 0.35rem;
    height: 2.25rem;
    background: var(--bg-sunk);
    color: var(--ink-3);
  }
  .search-btn:hover {
    --frame: var(--frame-hi);
    background: var(--bg-sunk);
  }
  .search-label {
    font-family: var(--font-body);
    font-size: 0.86rem;
    font-weight: 500;
    padding-right: 1.25rem;
  }
  .kbd {
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.02em;
    color: var(--ink-3);
    padding: 0.28rem 0.38rem 0.24rem;
    background: var(--bg-elev);
    box-shadow:
      inset 0 -2px 0 var(--line-strong),
      0 0 0 1px var(--line-strong);
  }
  /* Ngôn ngữ + ngày/đêm gom thành một cụm */
  .prefs {
    display: flex;
    align-items: center;
  }
  .prefs-sep {
    width: 2px;
    height: 1.4rem;
    background: linear-gradient(var(--line-strong) 50%, transparent 0) 0 0 / 2px 4px repeat-y;
  }
  @media (max-width: 1279px) {
    .search-label {
      display: none;
    }
  }
  .menu-btn {
    display: none;
  }
  .mb-close {
    display: none;
  }

  @media (max-width: 1060px) {
    .menu-btn {
      display: inline-flex;
    }
    .kbd {
      display: none;
    }
    .search-btn {
      background: none;
      box-shadow: none;
      margin-inline: 0;
      padding-inline: 0.6rem;
      height: 2.6rem;
      color: var(--ink-2);
    }
    .prefs-sep {
      display: none;
    }
    .bar {
      gap: 0.5rem;
    }
    .nav {
      --s: calc(var(--pu) * 2);
      position: fixed;
      top: calc(var(--header-h) + 0.75rem + 0.75rem);
      left: var(--gutter);
      right: var(--gutter);
      max-height: calc(100dvh - var(--header-h) - 3rem);
      overflow-y: auto;
      padding: var(--space-m) var(--space-l) var(--space-l);
      background: var(--bg-elev);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-8px);
      transition:
        opacity var(--dur) var(--ease-px),
        transform var(--dur) var(--ease-px),
        visibility 0s linear var(--dur);
    }
    .site-header[data-open='true'] .nav {
      opacity: 1;
      visibility: visible;
      transform: none;
      transition-delay: 0s;
    }
    .site-header[data-open='true'] .mb-open {
      display: none;
    }
    .site-header[data-open='true'] .mb-close {
      display: inline-grid;
    }
    .nav ul {
      flex-direction: column;
      align-items: stretch;
      gap: 0.1rem;
    }
    .nav a {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      font-size: var(--step-2);
      font-weight: 700;
      padding: 0.35rem 0.5rem;
      color: var(--ink);
    }
    .nav a::after {
      content: '';
      width: 0.42em;
      height: 0.6em;
      margin-left: auto;
      background: currentColor;
      clip-path: polygon(0 0, 33% 0, 33% 14%, 66% 14%, 66% 28%, 100% 28%, 100% 72%, 66% 72%, 66% 86%, 33% 86%, 33% 100%, 0 100%);
      opacity: 0.25;
    }
    .nav a[aria-current='page'] {
      box-shadow: inset 4px 0 0 var(--pop);
      background: var(--accent-tint);
    }
    .nav a[aria-current='page']::before {
      display: none;
    }
    .nav-extra {
      display: flex !important;
      flex-direction: row !important;
      gap: var(--space-m) !important;
      margin-top: var(--space-m);
      padding-top: var(--space-m) !important;
      border-top: 3px dotted var(--line-strong);
    }
    .nav-extra a {
      font-size: var(--step-1);
      color: var(--ink-2);
    }
    .nav-extra a::after {
      display: none;
    }
  }
  @media (max-width: 440px) {
    .bar {
      padding-inline: 0.6rem 0.2rem;
    }
    .brand {
      gap: 0.4rem;
      font-size: 1.4rem;
    }
    .brand :global(.brand-mark) {
      width: 28px;
      height: 28px;
    }
    .actions {
      gap: 0;
    }
    :global(.icon-btn) {
      min-width: 2.25rem;
      padding-inline: 0.35rem;
    }
    .search-btn {
      padding-inline: 0.35rem;
    }
  }
  @media (max-width: 350px) {
    .brand-name {
      display: none;
    }
  }
</style>
