---
import Sigil from './Sigil.astro';
import Icon from './Icon.astro';
import { t, type Lang } from '~/i18n/utils';
import { formatPeriod } from '~/lib/format';
import type { Item, WorkData } from '~/lib/content';

interface Props {
  item: Item;
  lang: Lang;
  size?: 'large' | 'normal';
  headingLevel?: 'h2' | 'h3';
}
const { item, lang, size = 'normal', headingLevel = 'h3' } = Astro.props;
const tr = t(lang);
const H = headingLevel;
const d = item.entry.data as WorkData;
const period = formatPeriod(d, lang);
---

<article class:list={['work-card', 'px', 'px-lift', `s-${size}`]} data-kind="work" data-category={d.category} lang={item.lang !== lang ? item.lang : undefined}>
  <div class="wc-art">
    <Sigil seed={item.key} chart twinkle />
  </div>
  <div class="wc-body">
    <div class="wc-top">
      <span class="kind-tag">{tr(`category.${d.category}`)}</span>
      <span class:list={['wc-status', `st-${d.status}`]}>{tr(`status.${d.status}`)}</span>
      {item.draft && <span class="badge-draft">{tr('meta.draft')}</span>}
      {item.lang !== lang && <span class="wc-lang">{item.lang.toUpperCase()}</span>}
    </div>
    <H class="wc-title"><a href={item.url}>{item.title}</a></H>
    <p class="wc-desc">{item.description}</p>
    {
      size === 'large' && d.highlights?.length > 0 && (
        <ul class="wc-highlights">
          {d.highlights.slice(0, 3).map((h: string) => (
            <li>{h}</li>
          ))}
        </ul>
      )
    }
    <p class="meta">
      <span><Icon name="calendar" size="12" /> {period}</span>
      <span><Icon name="briefcase" size="12" /> {d.role}</span>
    </p>
    {
      d.stack?.length > 0 && (
        <ul class="wc-stack">
          {d.stack.slice(0, size === 'large' ? 8 : 5).map((s: string) => (
            <li>{s}</li>
          ))}
        </ul>
      )
    }
  </div>
</article>

<style>
  .work-card {
    --hard: var(--work-bright);
    --s: calc(var(--pu) * 2);
    position: relative;
    display: grid;
    gap: var(--space-l);
    margin: var(--pu);
    padding: var(--space-l);
    background: var(--bg-elev);
  }
  :global(:root[data-theme='dark']) .work-card {
    --frame: color-mix(in srgb, var(--work-bright) 78%, var(--bg-elev));
    --hard: #05031a;
  }
  .work-card:hover {
    --s: calc(var(--pu) * 3);
  }
  .s-large {
    --s: calc(var(--pu) * 3);
    grid-template-columns: minmax(180px, 0.8fr) 2fr;
    align-items: center;
    padding: var(--space-xl);
  }
  .s-large:hover {
    --s: calc(var(--pu) * 4);
  }
  .wc-art {
    position: relative;
    aspect-ratio: 1;
    width: 100%;
    max-width: 260px;
    padding: 9%;
    background:
      linear-gradient(var(--sky-grid) 1px, transparent 1px) 0 0 / 12px 12px,
      linear-gradient(90deg, var(--sky-grid) 1px, transparent 1px) 0 0 / 12px 12px,
      linear-gradient(to bottom, var(--work-tint), color-mix(in srgb, var(--pop) 10%, transparent));
    box-shadow: inset 0 0 0 3px color-mix(in srgb, var(--work-bright) 55%, transparent);
  }
  :global(:root[data-theme='dark']) .wc-art {
    background:
      linear-gradient(var(--sky-grid) 1px, transparent 1px) 0 0 / 12px 12px,
      linear-gradient(90deg, var(--sky-grid) 1px, transparent 1px) 0 0 / 12px 12px,
      linear-gradient(to bottom, #0a0722, #1d1250 75%, #2e1863);
  }
  .s-normal .wc-art {
    width: 76px;
    height: 76px;
    padding: 6px;
  }
  .wc-body {
    display: grid;
    gap: 0.55rem;
    min-width: 0;
  }
  .wc-top {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.7rem;
    align-items: center;
  }
  .wc-status {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-family: var(--font-hud);
    font-size: 1.08rem;
    letter-spacing: 0.04em;
    color: var(--ink-3);
  }
  .wc-status::before {
    content: '';
    width: 8px;
    height: 8px;
    background: var(--ink-3);
  }
  .st-dang-lam::before {
    background: var(--note-bright);
    box-shadow: 0 0 0 2px var(--note-tint);
  }
  @media (prefers-reduced-motion: no-preference) {
    .st-dang-lam::before {
      animation: wc-led 1.2s steps(1, end) infinite;
    }
  }
  @keyframes wc-led {
    50% {
      background: var(--note);
    }
  }
  .st-hoan-thanh::before {
    background: var(--star-bright);
  }
  .wc-lang {
    font-family: var(--font-hud);
    font-size: 1rem;
    padding: 0 0.4em;
    color: var(--ink-3);
    box-shadow: inset 0 0 0 2px var(--line-strong);
  }
  .wc-title {
    font-size: var(--step-2);
    line-height: 1.05;
  }
  .s-large .wc-title {
    font-size: var(--step-3);
  }
  .wc-title a {
    color: var(--ink);
    text-decoration: none;
    background-image: linear-gradient(var(--pop), var(--pop));
    background-size: 0 4px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size 160ms steps(4, end);
  }
  .work-card:hover .wc-title a {
    background-size: 100% 4px;
  }
  .wc-title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .wc-desc {
    color: var(--ink-2);
    line-height: 1.65;
  }
  .wc-highlights {
    list-style: none;
    padding: 0;
    color: var(--ink-2);
    font-size: 0.95em;
    display: grid;
    gap: 0.3rem;
  }
  .wc-highlights li {
    position: relative;
    padding-left: 1.3em;
  }
  .wc-highlights li::before {
    content: '';
    position: absolute;
    left: 0.1em;
    top: 0.5em;
    width: 0.6em;
    height: 0.6em;
    background: var(--work-bright);
    clip-path: var(--clip-gem);
  }
  .wc-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    padding: 0;
    margin-top: 0.2rem;
  }
  .wc-stack li {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    padding: 0.1em 0.55em;
    background: var(--work-tint);
    color: var(--ink-2);
    box-shadow: inset 0 -2px 0 color-mix(in srgb, var(--work-bright) 45%, transparent);
  }
  .meta {
    font-family: var(--font-hud);
    font-size: 1.1rem;
    letter-spacing: 0.02em;
  }
  @media (max-width: 760px) {
    .s-large {
      grid-template-columns: 1fr;
      padding: var(--space-l);
    }
    .s-large .wc-art {
      max-width: 160px;
    }
  }
</style>
