---
/**
 * Thẻ dự án. size:
 *   'large'  — nổi bật: cửa sổ chòm sao lớn bên trái, có điểm chính (khung bậc 1)
 *   'normal' — lưới: ô chòm sao nhỏ cùng hàng nhãn loại/trạng thái (khung bậc 2)
 */
import Sigil from './Sigil.astro';
import Icon from './Icon.astro';
import { t, type Lang } from '~/i18n/utils';
import { formatPeriod } from '~/lib/format';
import type { Item, WorkData } from '~/lib/content';

interface Props {
  item: Item;
  lang: Lang;
  size?: 'large' | 'normal';
  headingLevel?: 'h2' | 'h3';
}
const { item, lang, size = 'normal', headingLevel = 'h3' } = Astro.props;
const tr = t(lang);
const H = headingLevel;
const d = item.entry.data as WorkData;
const period = formatPeriod(d, lang);
const stackMax = size === 'large' ? 6 : 4;
const stack = d.stack?.slice(0, stackMax) ?? [];
const stackMore = (d.stack?.length ?? 0) - stack.length;
---

<article
  class:list={['work-card', `s-${size}`, size === 'large' ? 'px' : 'px-soft', 'px-lift']}
  data-kind="work"
  data-category={d.category}
  lang={item.lang !== lang ? item.lang : undefined}
>
  {
    size === 'large' && (
      <div class="wc-art sky-window">
        <Sigil seed={item.key} chart twinkle />
      </div>
    )
  }
  <div class="wc-body">
    <div class="wc-top">
      {
        size === 'normal' && (
          <span class="sigil-chip sky-window">
            <Sigil seed={item.key} twinkle />
          </span>
        )
      }
      <span class="wc-tags">
        <span class="kind-tag">{tr(`category.${d.category}`)}</span>
        <span class:list={['wc-status', `st-${d.status}`]}>{tr(`status.${d.status}`)}</span>
        {item.draft && <span class="badge-draft">{tr('meta.draft')}</span>}
        {item.lang !== lang && <span class="wc-lang">{item.lang.toUpperCase()}</span>}
      </span>
    </div>
    <H class="wc-title"><a href={item.url}>{item.title}</a></H>
    <p class="wc-desc">{item.description}</p>
    {
      size === 'large' && d.highlights?.length > 0 && (
        <ul class="wc-highlights">
          {d.highlights.slice(0, 3).map((h: string) => (
            <li>{h}</li>
          ))}
        </ul>
      )
    }
    <p class="meta wc-meta">
      <span><Icon name="calendar" size="12" /> {period}</span>
      <span class="wc-role"><Icon name="briefcase" size="12" /> <span>{d.role}</span></span>
    </p>
    {
      stack.length > 0 && (
        <ul class="wc-stack">
          {stack.map((s: string) => (
            <li>{s}</li>
          ))}
          {stackMore > 0 && <li class="more">+{stackMore}</li>}
        </ul>
      )
    }
  </div>
</article>

<style>
  .work-card {
    position: relative;
    display: grid;
    margin: var(--pu);
    padding: var(--card-pad);
    background: var(--bg-elev);
    min-width: 0;
  }
  .s-large {
    --hard: var(--work-bright);
    --s: calc(var(--pu) * 2);
    grid-template-columns: minmax(10rem, 16rem) minmax(0, 1fr);
    gap: clamp(1.25rem, 3vw, 2.5rem);
    align-items: center;
  }
  :global(:root[data-theme='dark']) .s-large {
    --frame: color-mix(in srgb, var(--work-bright) 70%, var(--frame-hi));
    --hard: #05031a;
  }
  .s-large:hover {
    --s: calc(var(--pu) * 3);
  }
  .wc-art {
    aspect-ratio: 1;
    width: 100%;
    padding: 9%;
    box-shadow: inset 0 0 0 3px color-mix(in srgb, var(--work-bright) 55%, transparent);
  }
  .wc-body {
    display: grid;
    gap: 0.55rem;
    min-width: 0;
    align-content: start;
  }
  .s-normal .wc-body {
    height: 100%;
    grid-template-rows: auto auto 1fr auto auto;
  }
  .wc-top {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .s-normal .wc-top {
    margin-bottom: 0.2rem;
  }
  .wc-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.7rem;
    align-items: center;
  }
  .wc-status {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--ink-3);
  }
  .wc-status::before {
    content: '';
    width: 8px;
    height: 8px;
    background: var(--ink-3);
  }
  .st-dang-lam::before {
    background: var(--note-bright);
    box-shadow: 0 0 0 2px var(--note-tint);
  }
  @media (prefers-reduced-motion: no-preference) {
    .st-dang-lam::before {
      animation: wc-led 1.2s steps(1, end) infinite;
    }
  }
  @keyframes wc-led {
    50% {
      background: var(--note);
    }
  }
  .st-hoan-thanh::before {
    background: var(--star-bright);
  }
  .wc-lang {
    font-family: var(--font-label);
    font-size: 1rem;
    padding: 0 0.4em;
    color: var(--ink-3);
    box-shadow: inset 0 0 0 2px var(--line-strong);
  }
  .wc-title {
    font-size: var(--step-2);
    line-height: 1.08;
  }
  .s-large .wc-title {
    font-size: var(--step-3);
    line-height: 1.02;
  }
  .wc-title a {
    color: var(--ink);
    text-decoration: none;
    background-image: linear-gradient(var(--pop), var(--pop));
    background-size: 0 4px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size 160ms steps(4, end);
  }
  .work-card:hover .wc-title a,
  .wc-title a:focus-visible {
    background-size: 100% 4px;
  }
  .wc-title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .wc-desc {
    color: var(--ink-2);
    line-height: 1.65;
  }
  .s-normal .wc-desc {
    font-size: 0.97em;
  }
  .wc-highlights {
    list-style: none;
    padding: 0;
    color: var(--ink-2);
    font-size: 0.95em;
    display: grid;
    gap: 0.3rem;
  }
  .wc-highlights li {
    position: relative;
    padding-left: 1.3em;
  }
  .wc-highlights li::before {
    content: '';
    position: absolute;
    left: 0.1em;
    top: 0.5em;
    width: 0.6em;
    height: 0.6em;
    background: var(--work-bright);
    clip-path: var(--clip-gem);
  }
  .wc-meta {
    margin-top: 0.15rem;
    align-items: flex-start;
  }
  .wc-role {
    min-width: 0;
    align-items: flex-start !important;
  }
  .wc-role :global(.icon) {
    margin-top: 0.3em;
  }
  .s-normal .wc-role > span {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
  }
  .wc-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
    padding: 0;
    margin-top: 0.25rem;
  }
  .wc-stack li {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    line-height: 1.6;
    padding: 0.05em 0.55em;
    background: var(--work-tint);
    color: var(--ink-2);
    box-shadow: inset 0 -2px 0 color-mix(in srgb, var(--work-bright) 45%, transparent);
  }
  .wc-stack li.more {
    background: none;
    color: var(--ink-3);
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }
  @media (max-width: 760px) {
    .s-large {
      grid-template-columns: 1fr;
    }
    .s-large .wc-art {
      width: 7.5rem;
      padding: 8px;
    }
  }
</style>
