---
import Mascot from './Mascot.astro';
import { t, type Lang } from '~/i18n/utils';
interface Props {
  lang: Lang;
  title?: string;
  body?: string;
}
const { lang } = Astro.props;
const tr = t(lang);
const { title = tr('empty.title'), body = tr('empty.body') } = Astro.props;
---

<div class="empty px">
  <Mascot mood="sleepy" size={92} />
  <p class="empty-title">{title}</p>
  <p class="empty-body">{body}</p>
  <slot />
</div>

<style>
  .empty {
    --s: 0px;
    --frame: var(--line-strong);
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 0.5rem;
    margin: var(--pu);
    padding: var(--space-2xl) var(--space-l);
    background:
      repeating-linear-gradient(-45deg, transparent 0 10px, var(--accent-tint) 10px 12px),
      var(--bg-elev);
  }
  .empty-title {
    margin-top: var(--space-xs);
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 700;
    line-height: 1.1;
  }
  .empty-body {
    color: var(--ink-3);
  }
</style>
