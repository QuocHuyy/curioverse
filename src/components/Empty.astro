---
import Mascot from './Mascot.astro';
import { t, type Lang } from '~/i18n/utils';
interface Props {
  lang: Lang;
  title?: string;
  body?: string;
}
const { lang } = Astro.props;
const tr = t(lang);
const { title = tr('empty.title'), body = tr('empty.body') } = Astro.props;
---

<div class="empty px-flat">
  <Mascot mood="sleepy" size={56} />
  <div class="empty-text">
    <p class="empty-title">{title}</p>
    <p class="empty-body">{body}</p>
    <slot />
  </div>
</div>

<style>
  .empty {
    --frame: var(--line-strong);
    display: flex;
    align-items: center;
    gap: var(--space-l);
    margin: var(--pu);
    padding: var(--card-pad);
    background:
      repeating-linear-gradient(-45deg, transparent 0 10px, var(--accent-tint) 10px 12px),
      var(--bg-elev);
  }
  .empty-text {
    display: grid;
    gap: 0.2rem;
  }
  .empty-title {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 700;
    line-height: 1.1;
  }
  .empty-body {
    color: var(--ink-3);
  }
</style>
