---
/**
 * Font của giao diện pixel + anime — chỉ khai báo phần Latin + tiếng Việt
 * (các gói Fontsource có thêm hàng trăm mảnh tiếng Nhật mà site không cần).
 *
 * - Handjet (biến thiên, trục wght): chữ pixel cho tiêu đề, menu, nút.
 * - M PLUS Rounded 1c: chữ tròn kiểu giao diện game/anime Nhật cho thân bài.
 * - VT323: chữ "màn hình terminal" cho nhãn nhỏ, số liệu, phím tắt.
 * Cả ba đều có đủ dấu tiếng Việt.
 */
import hjLatin from '@fontsource-variable/handjet/files/handjet-latin-wght-normal.woff2?url';
import hjLatinExt from '@fontsource-variable/handjet/files/handjet-latin-ext-wght-normal.woff2?url';
import hjVi from '@fontsource-variable/handjet/files/handjet-vietnamese-wght-normal.woff2?url';

import mp400Latin from '@fontsource/m-plus-rounded-1c/files/m-plus-rounded-1c-latin-400-normal.woff2?url';
import mp400LatinExt from '@fontsource/m-plus-rounded-1c/files/m-plus-rounded-1c-latin-ext-400-normal.woff2?url';
import mp400Vi from '@fontsource/m-plus-rounded-1c/files/m-plus-rounded-1c-vietnamese-400-normal.woff2?url';
import mp500Latin from '@fontsource/m-plus-rounded-1c/files/m-plus-rounded-1c-latin-500-normal.woff2?url';
import mp500LatinExt from '@fontsource/m-plus-rounded-1c/files/m-plus-rounded-1c-latin-ext-500-normal.woff2?url';
import mp500Vi from '@fontsource/m-plus-rounded-1c/files/m-plus-rounded-1c-vietnamese-500-normal.woff2?url';
import mp700Latin from '@fontsource/m-plus-rounded-1c/files/m-plus-rounded-1c-latin-700-normal.woff2?url';
import mp700LatinExt from '@fontsource/m-plus-rounded-1c/files/m-plus-rounded-1c-latin-ext-700-normal.woff2?url';
import mp700Vi from '@fontsource/m-plus-rounded-1c/files/m-plus-rounded-1c-vietnamese-700-normal.woff2?url';
import mp800Latin from '@fontsource/m-plus-rounded-1c/files/m-plus-rounded-1c-latin-800-normal.woff2?url';
import mp800LatinExt from '@fontsource/m-plus-rounded-1c/files/m-plus-rounded-1c-latin-ext-800-normal.woff2?url';
import mp800Vi from '@fontsource/m-plus-rounded-1c/files/m-plus-rounded-1c-vietnamese-800-normal.woff2?url';

import vtLatin from '@fontsource/vt323/files/vt323-latin-400-normal.woff2?url';
import vtLatinExt from '@fontsource/vt323/files/vt323-latin-ext-400-normal.woff2?url';
import vtVi from '@fontsource/vt323/files/vt323-vietnamese-400-normal.woff2?url';

import type { Lang } from '~/i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const RANGE = {
  latin:
    'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD',
  latinExt:
    'U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF',
  vi: 'U+0102-0103,U+0110-0111,U+0128-0129,U+0168-0169,U+01A0-01A1,U+01AF-01B0,U+0300-0301,U+0303-0304,U+0308-0309,U+0323,U+0329,U+1EA0-1EF9,U+20AB',
};

type Face = { family: string; weight: string; files: [string, string, string] };
const faces: Face[] = [
  { family: 'Handjet Variable', weight: '100 900', files: [hjLatin, hjLatinExt, hjVi] },
  { family: 'M PLUS Rounded 1c', weight: '400', files: [mp400Latin, mp400LatinExt, mp400Vi] },
  { family: 'M PLUS Rounded 1c', weight: '500', files: [mp500Latin, mp500LatinExt, mp500Vi] },
  { family: 'M PLUS Rounded 1c', weight: '700', files: [mp700Latin, mp700LatinExt, mp700Vi] },
  { family: 'M PLUS Rounded 1c', weight: '800', files: [mp800Latin, mp800LatinExt, mp800Vi] },
  { family: 'VT323', weight: '400', files: [vtLatin, vtLatinExt, vtVi] },
];
const ranges = [RANGE.latin, RANGE.latinExt, RANGE.vi];
// File nhỏ (< 4KB) được Vite nhúng thẳng dạng data: URI — không cần (và không nên) preload
const preloads = [hjLatin, mp400Latin, ...(lang === 'vi' ? [hjVi, mp400Vi] : [])].filter((u) => !u.startsWith('data:'));
const css = faces
  .flatMap((f) =>
    f.files.map(
      (src, i) =>
        `@font-face{font-family:'${f.family}';font-style:normal;font-display:swap;font-weight:${f.weight};` +
        `src:url(${src}) format('woff2');unicode-range:${ranges[i]};}`,
    ),
  )
  .join('\n');
---

{preloads.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
<style is:inline set:html={css}></style>
