---
/**
 * Chòm sao riêng của một bài viết (cố định theo `seed`) — vẽ bằng pixel trên lưới 32×32.
 * Sao bám vào ô lưới, đường nối là đường Bresenham chấm chấm, vòng toạ độ là đường tròn pixel.
 */
import { makeSigil } from '~/lib/sigil';
import { bresenham, cellsPath, ringCells, sparkleCells, type Cell } from '~/lib/pixel';

interface Props {
  seed: string;
  class?: string;
  /** Vẽ thêm vòng toạ độ mờ phía sau */
  chart?: boolean;
  /** Cho sao lấp lánh (tôn trọng reduced-motion) */
  twinkle?: boolean;
  label?: string;
}
const { seed, class: className, chart = false, twinkle = false, label } = Astro.props;
const { stars, lines } = makeSigil(seed);

const G = 32;
const cell = 100 / G;
const snap = (v: number) => Math.min(G - 3, Math.max(2, Math.round(v / cell)));
const pts = stars.map((s) => ({ ...s, cx: snap(s.x), cy: snap(s.y) }));

const lineCells: Cell[] = [];
for (const [a, b] of lines) {
  const seg = bresenham(pts[a].cx, pts[a].cy, pts[b].cx, pts[b].cy);
  seg.forEach((c, i) => i > 1 && i < seg.length - 2 && i % 2 === 0 && lineCells.push(c));
}

const chartCells: Cell[] = [];
if (chart) {
  for (const r of [14, 9]) ringCells(16, 16, r).forEach(([x, y]) => (x + y) % 2 === 0 && chartCells.push([x, y]));
  for (let i = 1; i < G - 1; i += 3) chartCells.push([i, 16], [16, i]);
}

const starShapes = pts.map((s, i) => {
  const cells = s.bright ? sparkleCells(s.cx, s.cy, 3, 1) : s.r > 2 ? sparkleCells(s.cx, s.cy, 1, 0) : [[s.cx, s.cy] as Cell];
  return { d: cellsPath(cells, cell), bright: s.bright, delay: `${((i * 0.7) % 4).toFixed(1)}s` };
});
---

<svg
  class:list={['sigil', { twinkle }, className]}
  viewBox="0 0 100 100"
  preserveAspectRatio="xMidYMid meet"
  shape-rendering="crispEdges"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  {chart && <path class="sigil-chart" d={cellsPath(chartCells, cell)} />}
  <path class="sigil-lines" d={cellsPath(lineCells, cell)} />
  <g class="sigil-stars">
    {starShapes.map((s) => <path class:list={[s.bright ? 'sigil-bright' : 'sigil-dot']} d={s.d} style={`--d:${s.delay}`} />)}
  </g>
</svg>

<style>
  .sigil {
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .sigil-chart {
    fill: var(--sky-grid);
  }
  :global(:root[data-theme='light']) .sigil-chart {
    fill: rgba(35, 26, 59, 0.08);
  }
  .sigil-lines {
    fill: var(--kind, var(--ink-2));
    opacity: 0.55;
  }
  :global(:root[data-theme='dark']) .sigil-lines {
    fill: var(--sky-line-strong);
    opacity: 0.85;
  }
  .sigil-dot {
    fill: var(--sky-star);
    opacity: 0.9;
  }
  .sigil-bright {
    fill: var(--kind-bright, var(--star-bright));
  }
  :global(:root[data-theme='dark']) .sigil-stars {
    filter: var(--star-glow);
  }
  @media (prefers-reduced-motion: no-preference) {
    .twinkle .sigil-stars > * {
      animation: sg-twinkle 4.5s steps(1, end) infinite;
      animation-delay: var(--d, 0s);
    }
  }
  @keyframes sg-twinkle {
    0%,
    70% {
      opacity: 1;
    }
    71%,
    85% {
      opacity: 0.35;
    }
    86%,
    100% {
      opacity: 0.8;
    }
  }
</style>
