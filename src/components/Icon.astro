  | 'close'
  | 'arrow-right'
  | 'arrow-left'
  | 'arrow-up-right'
  | 'arrow-up'
  | 'github'
  | 'linkedin'
  | 'mail'
  | 'globe'
  | 'rss'
  | 'calendar'
  | 'clock'
  | 'map'
