---
/** Bộ icon pixel 12×12 — vẽ tay từng điểm ảnh, không phụ thuộc thư viện (xem lib/pixel-icons.ts). */
import { PIXEL_ICONS, type PixelIconName } from '~/lib/pixel-icons';
import { bitmapPath } from '~/lib/pixel';

export type IconName = PixelIconName;

interface Props {
  name: IconName;
  size?: number | string;
  label?: string;
  class?: string;
}
const { name, size = '1em', label, class: className } = Astro.props;
const d = bitmapPath(PIXEL_ICONS[name]);
// Khi mỗi điểm ảnh rơi đúng số nguyên pixel màn hình thì vẽ sắc cạnh
const px = Number(size);
const crisp = Number.isFinite(px) && px % 12 === 0;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 12 12"
  width={size}
  height={size}
  fill="currentColor"
  shape-rendering={crisp ? 'crispEdges' : undefined}
  class:list={['icon', className]}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
><path d={d} /></svg>
