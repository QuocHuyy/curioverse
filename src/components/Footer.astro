---
import Icon from './Icon.astro';
import Mascot from './Mascot.astro';
import Skyline from './Skyline.astro';
import { SITE } from '~/site.config';
import { sectionUrl, url, t, formatDate, type Lang } from '~/i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);
const year = new Date().getFullYear();
const explore = [
  ['stories', 'nav.stories'],
  ['work', 'nav.work'],
  ['journey', 'nav.journey'],
  ['notes', 'nav.notes'],
  ['universe', 'nav.universe'],
] as const;
---

<footer class="site-footer">
  <Skyline />
  <div class="footer-body">
  <div class="container grid">
    <div class="motto">
      <Mascot mood="sleepy" size={80} />
      <p>{tr('footer.motto')}</p>
    </div>
    <nav aria-label={tr('footer.explore')}>
      <h2>{tr('footer.explore')}</h2>
      <ul>
        {explore.map(([s, k]) => <li><a href={sectionUrl(s, lang)}>{tr(k)}</a></li>)}
      </ul>
    </nav>
    <nav aria-label={tr('footer.site')}>
      <h2>{tr('footer.site')}</h2>
      <ul>
        <li><a href={sectionUrl('about', lang)}>{tr('nav.about')}</a></li>
        <li><a href={sectionUrl('now', lang)}>{tr('nav.now')}</a></li>
        <li><a href={sectionUrl('topics', lang)}>{tr('nav.topics')}</a></li>
        <li><a href={sectionUrl('about', lang) + '#colophon'}>{tr('footer.colophon')}</a></li>
      </ul>
    </nav>
    <nav aria-label={tr('footer.connect')}>
      <h2>{tr('footer.connect')}</h2>
      <ul>
        {
          SITE.socials.map((s) => (
            <li>
              <a href={s.href} rel="me noopener">
                <Icon name={s.id} /> {s.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href={url(lang === 'en' ? '/en/rss.xml' : '/rss.xml')}>
            <Icon name="rss" /> {tr('footer.rss')}
          </a>
        </li>
      </ul>
    </nav>
  </div>
  <div class="container bottom">
    <p>© {SITE.since}–{year} {SITE.author} · {tr('footer.built')}</p>
    <p>{tr('footer.lastBuild')}: {formatDate(new Date(), lang)}</p>
    <a class="to-top" href="#top"><Icon name="arrow-up" /> {tr('footer.top')}</a>
  </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-4xl);
    font-size: var(--step--1);
  }
  .footer-body {
    position: relative;
    background: var(--bg-sunk);
    padding-block: var(--space-2xl) var(--space-l);
  }
  :global(:root[data-theme='dark']) .footer-body {
    background: #0b0820;
  }
  .grid {
    display: grid;
    grid-template-columns: 1.6fr repeat(3, 1fr);
    gap: var(--space-xl);
  }
  .motto {
    display: flex;
    gap: var(--space-m);
    align-items: center;
  }
  .motto p {
    font-family: var(--font-pixel);
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.2;
    color: var(--ink-2);
    max-width: 18em;
  }
  h2 {
    display: inline-block;
    font-family: var(--font-hud);
    font-size: 1.1rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: var(--space-s);
    padding-bottom: 0.1rem;
    border-bottom: 3px solid var(--pop);
  }
  ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.4rem;
  }
  a {
    color: var(--ink-2);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
  }
  nav a::before {
    content: '';
    width: 0.4em;
    height: 0.6em;
    background: var(--pop);
    clip-path: polygon(0 0, 33% 0, 33% 14%, 66% 14%, 66% 28%, 100% 28%, 100% 72%, 66% 72%, 66% 86%, 33% 86%, 33% 100%, 0 100%);
    opacity: 0;
    margin-left: -0.85em;
    transition: opacity 100ms steps(1, end);
  }
  nav a:hover::before {
    opacity: 1;
  }
  a:hover {
    color: var(--accent);
  }
  .bottom {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-l);
    justify-content: space-between;
    align-items: center;
    margin-top: var(--space-2xl);
    padding-top: var(--space-l);
    background: linear-gradient(90deg, var(--line-strong) 50%, transparent 0) top left / 8px 3px repeat-x;
    color: var(--ink-3);
    font-family: var(--font-hud);
    font-size: 1.1rem;
    letter-spacing: 0.02em;
  }
  .to-top {
    color: var(--ink-3);
  }
  @media (max-width: 860px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .motto {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 520px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
    .bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
