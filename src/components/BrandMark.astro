---
/** Logo pixel: ngôi sao 4 cánh, quỹ đạo nghiêng chấm chấm và một vệ tinh nhỏ (lưới 17×17). */
import { brandMark } from '~/lib/brand';
interface Props {
  size?: string;
}
const { size = '34px' } = Astro.props;
const { orbit, core, coreLight, moon } = brandMark();
---

<svg class="brand-mark" viewBox="0 0 17 17" width={size} height={size} shape-rendering="crispEdges" aria-hidden="true">
  <g class="core">
    <path class="core-fill" d={core} />
    <path class="core-light" d={coreLight} />
  </g>
  <path class="orbit" d={orbit} />
  <path class="moonlet" d={moon} />
</svg>

<style>
  .brand-mark {
    flex: none;
    overflow: visible;
  }
  .orbit {
    fill: var(--ink-3);
  }
  .core-fill {
    fill: var(--star-bright);
  }
  .core-light {
    fill: #fff6cf;
  }
  .moonlet {
    fill: var(--pop);
  }
  :global(:root[data-theme='dark']) .core {
    filter: drop-shadow(0 0 2px rgba(255, 226, 143, 0.8));
  }
</style>
