---
import Icon from './Icon.astro';
import { JOURNEY_ICONS } from './journey-icons';
import { formatDate, t, url, type Lang } from '~/i18n/utils';
import type { Milestone } from '~/lib/content';

interface Props {
  milestones: Milestone[];
  lang: Lang;
}
const { milestones, lang } = Astro.props;
const tr = t(lang);

const years = new Map<number, Milestone[]>();
for (const m of milestones) {
  const y = Number(new Intl.DateTimeFormat('en', { year: 'numeric', timeZone: 'Asia/Ho_Chi_Minh' }).format(m.date));
  years.set(y, [...(years.get(y) ?? []), m]);
}
const kinds = [...new Set(milestones.map((m) => m.kind))];
const href = (link?: string) => (link ? (/^https?:/.test(link) ? link : link.startsWith(import.meta.env.BASE_URL.replace(/\/$/, '') + '/') ? link : url(link)) : undefined);
---

<div class="timeline">
  {
    kinds.length > 1 && (
      <div class="tl-filters" role="group" aria-label={tr('journey.title')}>
        <button class="chip" type="button" aria-pressed="true" data-tl-filter="all">
          {tr('journey.all')}
        </button>
        {kinds.map((k) => (
          <button class="chip" type="button" aria-pressed="false" data-tl-filter={k}>
            <Icon name={JOURNEY_ICONS[k]} /> {tr(`journey.${k}`)}
          </button>
        ))}
      </div>
    )
  }
  <ol class="tl-years">
    {
      [...years.entries()].map(([year, items]) => (
        <li class="tl-year">
          <h2 class="tl-year-label">{year}</h2>
          <ol class="tl-items">
            {items.map((m) => {
              const link = href(m.link);
              const external = link && /^https?:/.test(link);
              return (
                <li class="tl-item" data-k={m.kind}>
                  <span class="tl-dot" aria-hidden="true">
                    <Icon name={JOURNEY_ICONS[m.kind]} size="16" />
                  </span>
                  <div class="tl-card">
                    <p class="tl-date">
                      <time datetime={m.date.toISOString()}>{formatDate(m.date, lang, m.precision)}</time>
                      <span class="tl-kind">{tr(`journey.${m.kind}`)}</span>
                      {m.draft && <span class="badge-draft">{tr('meta.draft')}</span>}
                    </p>
                    <h3 class="tl-title">
                      {link ? (
                        <a href={link} rel={external ? 'noopener' : undefined}>
                          {m.title}
                          {external && <Icon name="arrow-up-right" />}
                        </a>
                      ) : (
                        m.title
                      )}
                    </h3>
                    {m.description && <p class="tl-desc">{m.description}</p>}
                  </div>
                </li>
              );
            })}
          </ol>
        </li>
      ))
    }
  </ol>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.timeline').forEach((root) => {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-tl-filter]')];
    buttons.forEach((btn) =>
      btn.addEventListener('click', () => {
        const k = btn.dataset.tlFilter;
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        root.querySelectorAll<HTMLElement>('.tl-item').forEach((item) => {
          item.hidden = k !== 'all' && item.dataset.k !== k;
        });
        root.querySelectorAll<HTMLElement>('.tl-year').forEach((year) => {
          year.hidden = !year.querySelector('.tl-item:not([hidden])');
        });
      }),
    );
  });
</script>

<style>
  .tl-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: var(--space-2xl);
  }
  .tl-years {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-2xl);
  }
  .tl-year {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: var(--space-l);
  }
  .tl-year-label {
    position: sticky;
    top: calc(var(--header-h) + 1rem);
    align-self: start;
    font-size: var(--step-4);
    font-weight: 500;
    color: var(--ink-3);
    line-height: 1;
    font-variant-numeric: lining-nums;
  }
  .tl-items {
    list-style: none;
    padding: 0 0 0 2.2rem;
    position: relative;
    display: grid;
    gap: var(--space-l);
  }
  .tl-items::before {
    content: '';
    position: absolute;
    left: 0.85rem;
    top: 0.6rem;
    bottom: 0.6rem;
    border-left: 1.5px dashed var(--line-strong);
  }
  .tl-item {
    position: relative;
  }
  .tl-dot {
    position: absolute;
    left: -2.2rem;
    top: 0.85rem;
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: var(--bg);
    border: 1.5px solid var(--line-strong);
    color: var(--star);
  }
  .tl-item:first-child .tl-dot {
    border-color: var(--star-bright);
    box-shadow: 0 0 0 4px var(--star-tint);
  }
  .tl-card {
    padding: var(--space-m) var(--space-l);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-elev);
  }
  .tl-date {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 0.7rem;
    align-items: center;
    font-size: var(--step--1);
    color: var(--ink-3);
  }
  .tl-kind {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--star);
  }
  .tl-title {
    font-size: var(--step-1);
    margin-top: 0.15rem;
    line-height: 1.35;
  }
  .tl-title a {
    color: var(--ink);
    text-decoration-color: var(--line-strong);
  }
  .tl-title a:hover {
    color: var(--accent);
  }
  .tl-title :global(svg) {
    display: inline;
    width: 0.8em;
    vertical-align: 0.05em;
    margin-left: 0.2em;
  }
  .tl-desc {
    margin-top: 0.3rem;
    color: var(--ink-2);
    font-size: 0.96em;
  }
  @media (max-width: 720px) {
    .tl-year {
      grid-template-columns: 1fr;
      gap: var(--space-m);
    }
    .tl-year-label {
      position: static;
      font-size: var(--step-3);
    }
  }
</style>
