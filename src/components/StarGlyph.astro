---
/** Ký hiệu độ chín bằng pixel (lưới 11×11): Tinh vân (mây chấm điểm) · Tiền sao (sao nhỏ + vòng) · Ngôi sao. */
import type { Stage } from '~/lib/content';
import { cellsPath, discCells, ringCells, sparkleCells, type Cell } from '~/lib/pixel';

interface Props {
  stage?: Stage;
  size?: string;
  class?: string;
}
const { stage = 'star', size = '1em', class: className } = Astro.props;

let solid: Cell[] = [];
let soft: Cell[] = [];
if (stage === 'star') {
  solid = sparkleCells(5, 5, 5, 2);
} else if (stage === 'protostar') {
  solid = sparkleCells(5, 5, 2, 1);
  soft = ringCells(5, 5, 5).filter(([x, y]) => (x + y) % 2 === 0);
} else {
  // tinh vân: mây elip, rìa chấm điểm (dither), lõi đặc
  const cloud = discCells(5, 5, 5).filter(([x, y]) => ((x - 5) / 5.4) ** 2 + ((y - 5) / 3.8) ** 2 <= 1);
  const inner = new Set(discCells(5, 5, 2).map(([x, y]) => `${x},${y}`));
  soft = cloud.filter(([x, y]) => !inner.has(`${x},${y}`) && (x + y) % 2 === 0);
  solid = discCells(5, 5, 1);
}
---

<svg
  class:list={['glyph-px', `glyph-${stage}`, className]}
  viewBox="0 0 11 11"
  width={size}
  height={size}
  shape-rendering="crispEdges"
  aria-hidden="true"
>
  {soft.length > 0 && <path d={cellsPath(soft)} fill="currentColor" opacity={stage === 'nebula' ? 0.6 : 0.45} />}
  <path d={cellsPath(solid)} fill="currentColor" />
</svg>

<style>
  .glyph-px {
    display: inline-block;
    flex: none;
    vertical-align: -0.12em;
  }
  .glyph-star {
    color: var(--star-bright);
  }
  .glyph-protostar {
    color: var(--note-bright);
  }
  .glyph-nebula {
    color: var(--work-bright);
  }
  :global(:root[data-theme='light']) .glyph-star {
    color: #e89a00;
  }
  :global(:root[data-theme='light']) .glyph-protostar {
    color: var(--note);
  }
  :global(:root[data-theme='light']) .glyph-nebula {
    color: var(--work);
  }
</style>
