---
/**
 * Chòm sao thu nhỏ ở hero trang chủ: các bài viết thật, vị trí lấy từ Bản đồ sao — vẽ kiểu pixel.
 * Không cần JavaScript — nhãn hiện khi hover/focus bằng CSS.
 */
import { getGraph } from '~/lib/graph';
import { makeSigil, starfield } from '~/lib/sigil';
import { bresenham, cellsPath, discCells, sparkleCells, type Cell } from '~/lib/pixel';
import { t, type Lang } from '~/i18n/utils';

interface Props {
  lang: Lang;
  max?: number;
}
const { lang, max = 26 } = Astro.props;
const tr = t(lang);
const graph = await getGraph(lang);

const VW = 560;
const VH = 380;
// Lề: chừa góc dưới bên trái cho Curio đứng
const PAD = { l: 96, r: 64, t: 48, b: 72 };
const CELL = 4; // 1 điểm ảnh = 4 đơn vị SVG
const snap = (v: number) => Math.round(v / CELL) * CELL;

const picked = graph.nodes
  .slice()
  .sort((a, b) => b.degree - a.degree || b.date.localeCompare(a.date))
  .slice(0, max);
const ids = new Set(picked.map((n) => n.id));
const xs = picked.length ? picked.map((n) => n.x) : [500];
const ys = picked.length ? picked.map((n) => n.y) : [320];
const minX = Math.min(...xs);
const maxX = Math.max(...xs);
const minY = Math.min(...ys);
const maxY = Math.max(...ys);
const innerW = VW - PAD.l - PAD.r;
const innerH = VH - PAD.t - PAD.b;
const s = Math.min(innerW / Math.max(maxX - minX, 1), innerH / Math.max(maxY - minY, 1), 1.4);
const cx = (minX + maxX) / 2;
const cy = (minY + maxY) / 2;
const nodes = picked.map((n) => ({
  ...n,
  px: snap(PAD.l + innerW / 2 + (n.x - cx) * s),
  py: snap(PAD.t + innerH / 2 + (n.y - cy) * s),
}));
const pos = new Map(nodes.map((n) => [n.id, n]));
const edges = graph.edges.filter((e) => ids.has(e.source) && ids.has(e.target));

// Đường nối pixel (lưới 4)
const strongCells: Cell[] = [];
const weakCells: Cell[] = [];
for (const e of edges) {
  const a = pos.get(e.source)!;
  const b = pos.get(e.target)!;
  const seg = bresenham(a.px / CELL, a.py / CELL, b.px / CELL, b.py / CELL);
  seg.forEach((c, i) => {
    if (i < 3 || i > seg.length - 4) return;
    if (e.strong) strongCells.push(c);
    else if (i % 3 === 0) weakCells.push(c);
  });
}

// Vòng toạ độ elip — chấm pixel
const chartCells: Cell[] = [];
for (const f of [0.46, 0.31, 0.16]) {
  const rx = (VW * f) / CELL;
  const ry = (VH * (f - 0.02)) / CELL;
  const steps = Math.round((rx + ry) * 2.2);
  for (let i = 0; i < steps; i++) {
    const t = (i / steps) * Math.PI * 2;
    chartCells.push([Math.round(VW / 2 / CELL + rx * Math.cos(t)), Math.round(VH / 2 / CELL + ry * Math.sin(t))]);
  }
}
for (let x = 4; x < VW / CELL - 4; x += 4) chartCells.push([x, VH / 2 / CELL]);
for (let y = 4; y < VH / CELL - 4; y += 4) chartCells.push([VW / 2 / CELL, y]);

// Nền sao li ti (ô 2px)
const bg = starfield(`hero-${lang}`, 150, VW, VH);
const bgPath = cellsPath(
  bg.map((d) => [Math.round(d.x / 2), Math.round(d.y / 2)] as Cell),
  2,
);
const bgBright = bg.filter((d) => d.o > 0.7);

// Chòm sao nền mờ — giúp hero không trống trải khi mới có ít bài
const ghostCells: Cell[] = [];
const GHOSTS = [
  { seed: 'hero-ghost-a', n: [6, 7], ox: VW * 0.04, oy: VH * 0.02, sc: 2.1 },
  { seed: 'hero-ghost-b', n: [5, 6], ox: VW * 0.56, oy: 0, sc: 2.2 },
  { seed: 'hero-ghost-c', n: [4, 5], ox: VW * 0.6, oy: VH * 0.5, sc: 1.8 },
];
GHOSTS.forEach(({ seed: gs, n, ox, oy, sc }) => {
  const g = makeSigil(gs, { min: n[0], max: n[1] });
  const p = g.stars.map((st) => [Math.round((ox + st.x * sc) / CELL), Math.round((oy + st.y * sc) / CELL)] as Cell);
  p.forEach((c) => ghostCells.push(c));
  g.lines.forEach(([a, b]) => bresenham(p[a][0], p[a][1], p[b][0], p[b][1]).forEach((c, i) => i % 4 === 2 && ghostCells.push(c)));
});
---

<figure class="mini-constellation" aria-label={tr('home.miniMapLabel')}>
  <svg viewBox={`0 0 ${VW} ${VH}`} role="group" shape-rendering="crispEdges">
    <path class="mc-chart" d={cellsPath(chartCells, CELL, -CELL / 2, -CELL / 2)} aria-hidden="true" />
    <g class="mc-bg" aria-hidden="true">
      <path d={bgPath} />
      {bgBright.map((d) => <rect x={Math.round(d.x / 2) * 2} y={Math.round(d.y / 2) * 2} width="2" height="2" style={`--d:${d.d}s`} />)}
    </g>
    <path class="mc-ghost" d={cellsPath(ghostCells, CELL, -CELL / 2, -CELL / 2)} aria-hidden="true" />
    <g class="mc-edges" aria-hidden="true">
      <path class="weak" d={cellsPath(weakCells, CELL, -CELL / 2, -CELL / 2)} />
      <path class="strong" d={cellsPath(strongCells, CELL, -CELL / 2, -CELL / 2)} />
    </g>
    <g class="mc-nodes">
      {
        nodes.map((n, i) => {
          const sparkle = n.kind === 'stories' || n.stage === 'star' || n.featured;
          const r = Math.max(2, Math.round((n.r * 1.25) / CELL));
          const cells = sparkle ? sparkleCells(0, 0, r + 1, 1) : discCells(0, 0, Math.max(1, r - 1));
          const anchor = n.px > VW * 0.62 ? 'end' : n.px < VW * 0.38 ? 'start' : 'middle';
          const gap = (r + 2) * CELL;
          const lx = anchor === 'end' ? n.px - gap : anchor === 'start' ? n.px + gap : n.px;
          const ly = anchor === 'middle' ? n.py - gap - 4 : n.py + 6;
          return (
            <a href={n.url} class="mc-node" data-kind={n.kind} aria-label={n.title}>
              <rect class="mc-hit" x={n.px - 16} y={n.py - 16} width="32" height="32" />
              <path
                class="mc-star"
                d={cellsPath(cells, CELL, n.px - CELL / 2, n.py - CELL / 2)}
                style={`--d:${((i * 0.37) % 4).toFixed(2)}s`}
              />
              <text x={lx} y={ly} text-anchor={anchor} class="mc-label">
                {n.title.length > 34 ? n.title.slice(0, 32) + '…' : n.title}
              </text>
            </a>
          );
        })
      }
    </g>
  </svg>
</figure>

<style>
  .mini-constellation {
    position: relative;
    width: 100%;
    aspect-ratio: 560 / 380;
  }
  svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .mc-chart {
    fill: var(--sky-grid);
  }
  :global(:root[data-theme='light']) .mc-chart {
    fill: rgba(35, 26, 59, 0.1);
  }
  .mc-bg path,
  .mc-bg rect {
    fill: var(--sky-star);
    opacity: 0.35;
  }
  .mc-bg rect {
    opacity: 0.9;
  }
  :global(:root[data-theme='light']) .mc-bg path {
    opacity: 0.12;
  }
  :global(:root[data-theme='light']) .mc-bg rect {
    opacity: 0.3;
  }
  .mc-ghost {
    fill: var(--sky-star);
    opacity: 0.16;
  }
  .mc-edges .weak {
    fill: var(--sky-line-strong);
    opacity: 0.6;
  }
  .mc-edges .strong {
    fill: var(--sky-line-strong);
  }
  .mc-hit {
    fill: transparent;
  }
  .mc-star {
    fill: var(--kind-bright);
    transition: transform 160ms var(--ease-px);
    transform-box: fill-box;
    transform-origin: center;
  }
  :global(:root[data-theme='dark']) .mc-star {
    filter: drop-shadow(0 0 5px var(--kind-bright));
  }
  .mc-label {
    font-family: var(--font-pixel);
    font-size: 19px;
    font-weight: 700;
    fill: var(--ink);
    paint-order: stroke;
    stroke: var(--bg-elev);
    stroke-width: 6px;
    stroke-linejoin: miter;
    opacity: 0;
    pointer-events: none;
  }
  .mc-node {
    outline: none;
  }
  .mc-node:hover .mc-label,
  .mc-node:focus-visible .mc-label {
    opacity: 1;
  }
  .mc-node:hover .mc-star,
  .mc-node:focus-visible .mc-star {
    transform: scale(1.5);
  }
  .mc-node:focus-visible .mc-hit {
    stroke: var(--focus);
    stroke-width: 3;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(:root[data-theme='dark']) .mc-bg rect {
      animation: mc-twinkle 4s steps(1, end) infinite;
      animation-delay: var(--d);
    }
    .mc-star {
      animation: mc-pulse 5s steps(1, end) infinite;
      animation-delay: var(--d);
    }
  }
  @keyframes mc-twinkle {
    50% {
      opacity: 0.15;
    }
  }
  @keyframes mc-pulse {
    0%,
    88% {
      opacity: 1;
    }
    89%,
    94% {
      opacity: 0.55;
    }
  }
</style>
