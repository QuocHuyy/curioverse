---
import type { MarkdownHeading } from 'astro';
import { t, type Lang } from '~/i18n/utils';
interface Props {
  headings: MarkdownHeading[];
  lang: Lang;
}
const { headings, lang } = Astro.props;
const tr = t(lang);
const items = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{
  items.length >= 2 && (
    <nav class="toc px-flat" aria-label={tr('meta.toc')} data-pagefind-ignore>
      <details open>
        <summary>{tr('meta.toc')}</summary>
        <ol>
          {items.map((h) => (
            <li class={`d${h.depth}`}>
              <a href={`#${h.slug}`} data-toc-link={h.slug}>
                {h.text}
              </a>
            </li>
          ))}
        </ol>
      </details>
    </nav>
  )
}

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
  if (links.length) {
    const targets = links
      .map((a) => document.getElementById(a.dataset.tocLink!))
      .filter((el): el is HTMLElement => !!el);
    const setActive = (id: string) =>
      links.forEach((a) => a.toggleAttribute('aria-current', a.dataset.tocLink === id));
    const io = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible[0]) setActive(visible[0].target.id);
      },
      { rootMargin: '-15% 0px -70% 0px' },
    );
    targets.forEach((el) => io.observe(el));
    // Thu gọn mục lục trên màn hình nhỏ
    if (matchMedia('(max-width: 1179px)').matches) {
      document.querySelector('.toc details')?.removeAttribute('open');
    }
  }
</script>

<style>
  .toc {
    margin: 2px;
    padding: 0.7rem 0.6rem 0.75rem;
    background: color-mix(in srgb, var(--bg-elev) 75%, transparent);
    font-size: 0.86rem;
  }
  summary {
    cursor: pointer;
    padding-inline: 0.4rem;
    font-family: var(--font-label);
    font-size: 1.1rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
    list-style-position: inside;
  }
  details[open] summary {
    margin-bottom: var(--space-xs);
  }
  ol {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.05rem;
  }
  li.d3 {
    padding-left: 0.9rem;
  }
  a {
    position: relative;
    display: block;
    padding: 0.25rem 0.4rem 0.25rem 1.1rem;
    color: var(--ink-3);
    text-decoration: none;
    line-height: 1.45;
  }
  a::before {
    content: '';
    position: absolute;
    left: 0.15rem;
    top: 0.62em;
    width: 0.42em;
    height: 0.6em;
    background: var(--pop);
    clip-path: polygon(0 0, 33% 0, 33% 14%, 66% 14%, 66% 28%, 100% 28%, 100% 72%, 66% 72%, 66% 86%, 33% 86%, 33% 100%, 0 100%);
    opacity: 0;
  }
  a:hover {
    color: var(--ink);
    background: var(--accent-tint);
  }
  a[aria-current] {
    color: var(--ink);
    font-weight: 700;
    background: var(--accent-tint);
  }
  a[aria-current]::before {
    opacity: 1;
  }
  @media (prefers-reduced-motion: no-preference) {
    a[aria-current]::before {
      animation: toc-blink 1s steps(1, end) infinite;
    }
  }
  @keyframes toc-blink {
    50% {
      opacity: 0.2;
    }
  }
  @media (max-width: 1179px) {
    .toc {
      --frame: var(--line-strong);
      padding: 0.6rem 0.7rem;
      background: var(--bg-elev);
    }
  }
</style>
