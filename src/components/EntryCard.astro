---
/**
 * Thẻ bài dùng chung: câu chuyện, ghi chép, dự án (dạng gọn).
 * variant: 'row' (danh sách theo năm) · 'card' (lưới) · 'compact' (liên quan / backlinks)
 */
import Sigil from './Sigil.astro';
import StageBadge from './StageBadge.astro';
import Icon from './Icon.astro';
import { formatDate, t, type Lang } from '~/i18n/utils';
import type { Item } from '~/lib/content';

interface Props {
  item: Item;
  lang: Lang;
  variant?: 'row' | 'card' | 'compact';
  headingLevel?: 'h2' | 'h3' | 'h4';
  showKind?: boolean;
}
const { item, lang, variant = 'card', headingLevel = 'h3', showKind = false } = Astro.props;
const tr = t(lang);
const H = headingLevel;
const kindLabel = tr(`kind.${item.kind}.one`);
const dateLabel =
  item.kind === 'notes'
    ? `${tr('meta.tended')}: ${formatDate(item.sortDate, lang)}`
    : formatDate(item.date, lang, item.kind === 'work' ? ((item.entry.data as any).periodPrecision ?? 'month') : 'day');
---

<article class:list={['entry-card', `v-${variant}`, { px: variant !== 'row', 'px-lift': variant !== 'row' }]} data-kind={item.kind} lang={item.lang !== lang ? item.lang : undefined}>
  {
    variant !== 'compact' && (
      <div class="ec-art">
        <Sigil seed={item.key} twinkle />
      </div>
    )
  }
  <div class="ec-body">
    <div class="ec-top">
      {showKind && <span class="kind-tag">{kindLabel}</span>}
      {item.stage && <StageBadge stage={item.stage} lang={lang} />}
      {item.draft && <span class="badge-draft">{tr('meta.draft')}</span>}
      {item.lang !== lang && <span class="ec-lang" title={tr('lang.onlyIn')}>{item.lang.toUpperCase()}</span>}
    </div>
    <H class="ec-title">
      <a href={item.url}>{item.title}</a>
    </H>
    {variant !== 'compact' && <p class="ec-desc">{item.description}</p>}
    <p class="meta ec-meta">
      <span><time datetime={item.date.toISOString()}>{dateLabel}</time></span>
      {item.kind !== 'work' && (
        <span>
          <Icon name="clock" size="12" /> {item.readingMinutes} {tr('meta.minRead')}
        </span>
      )}
    </p>
  </div>
</article>

<style>
  .entry-card {
    position: relative;
    display: grid;
    gap: var(--space-m);
    align-items: start;
  }
  /* Thẻ lưới: cửa sổ pixel, bóng đổ mang màu của loại bài (ban ngày) */
  .v-card {
    --hard: var(--kind-bright);
    --s: calc(var(--pu) * 2);
    grid-template-rows: auto 1fr;
    margin: var(--pu);
    padding: var(--space-l);
    background: var(--bg-elev);
  }
  :global(:root[data-theme='dark']) .v-card,
  :global(:root[data-theme='dark']) .v-compact {
    --frame: color-mix(in srgb, var(--kind-bright) 78%, var(--bg-elev));
    --hard: #05031a;
  }
  .v-card:hover {
    --s: calc(var(--pu) * 3);
  }
  .ec-art {
    position: relative;
    background:
      linear-gradient(var(--sky-grid) 1px, transparent 1px) 0 0 / 8px 8px,
      linear-gradient(90deg, var(--sky-grid) 1px, transparent 1px) 0 0 / 8px 8px,
      var(--kind-tint);
    box-shadow: inset 0 0 0 2px color-mix(in srgb, var(--kind-bright) 55%, transparent);
  }
  .v-card .ec-art {
    width: 76px;
    height: 76px;
    padding: 6px;
  }
  /* Dòng danh sách: phân cách bằng hàng chấm pixel */
  .v-row {
    grid-template-columns: 68px 1fr;
    gap: var(--space-l);
    padding-block: var(--space-l);
    background: linear-gradient(90deg, var(--line-strong) 50%, transparent 0) top left / 8px 3px repeat-x;
  }
  .v-row .ec-art {
    width: 68px;
    height: 68px;
    padding: 6px;
    margin-top: 0.3rem;
  }
  .v-compact {
    --pu: 2px;
    --frame: var(--line-strong);
    --s: calc(var(--pu) * 2);
    --hard: var(--kind-bright);
    margin: var(--pu);
    padding: var(--space-m) var(--space-m) var(--space-m) calc(var(--space-l) + 2px);
    background:
      linear-gradient(var(--kind-bright), var(--kind-bright)) left / 6px 100% no-repeat,
      var(--bg-elev);
  }
  .v-compact:hover {
    --frame: var(--ink);
  }
  .ec-body {
    display: grid;
    gap: 0.4rem;
    min-width: 0;
  }
  .ec-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.6rem;
    min-height: 0;
  }
  .ec-top:empty {
    display: none;
  }
  .ec-lang {
    font-family: var(--font-hud);
    font-size: 1rem;
    letter-spacing: 0.06em;
    line-height: 1.3;
    padding: 0 0.4em;
    color: var(--ink-3);
    box-shadow: inset 0 0 0 2px var(--line-strong);
  }
  .ec-title {
    font-size: var(--step-2);
    font-weight: 700;
    line-height: 1.05;
  }
  .v-compact .ec-title {
    font-size: 1.45rem;
  }
  .ec-title a {
    color: var(--ink);
    text-decoration: none;
    background-image: linear-gradient(var(--pop), var(--pop));
    background-size: 0 4px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size 160ms steps(4, end);
  }
  .entry-card:hover .ec-title a {
    background-size: 100% 4px;
  }
  /* Cả thẻ bấm được */
  .ec-title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .ec-desc {
    color: var(--ink-2);
    font-size: 0.97em;
    line-height: 1.65;
  }
  .ec-meta {
    margin-top: 0.2rem;
    font-family: var(--font-hud);
    font-size: 1.1rem;
    letter-spacing: 0.02em;
  }
  @media (max-width: 560px) {
    .v-row {
      grid-template-columns: 1fr;
      gap: var(--space-s);
    }
    .v-row .ec-art {
      width: 52px;
      height: 52px;
      padding: 4px;
    }
  }
</style>
