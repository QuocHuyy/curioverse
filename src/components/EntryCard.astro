---
/**
 * Thẻ bài dùng chung: câu chuyện, ghi chép, dự án (dạng gọn).
 * variant:
 *   'feature' — bài nổi bật ở trang chủ: cửa sổ chòm sao lớn + chữ (khung bậc 1)
 *   'card'    — lưới: ô chòm sao nhỏ nằm cùng hàng nhãn (khung bậc 2)
 *   'row'     — danh sách theo năm: phân cách bằng hàng chấm pixel, không khung
 *   'compact' — liên quan / backlinks: khung bậc 3 có vạch màu theo loại
 */
import Sigil from './Sigil.astro';
import StageBadge from './StageBadge.astro';
import Icon from './Icon.astro';
import { formatDate, t, type Lang } from '~/i18n/utils';
import type { Item } from '~/lib/content';

interface Props {
  item: Item;
  lang: Lang;
  variant?: 'feature' | 'row' | 'card' | 'compact';
  headingLevel?: 'h2' | 'h3' | 'h4';
  showKind?: boolean;
}
const { item, lang, variant = 'card', headingLevel = 'h3', showKind = false } = Astro.props;
const tr = t(lang);
const H = headingLevel;
const kindLabel = tr(`kind.${item.kind}.one`);
const dateLabel =
  item.kind === 'notes'
    ? `${tr('meta.tended')}: ${formatDate(item.sortDate, lang)}`
    : formatDate(item.date, lang, item.kind === 'work' ? ((item.entry.data as any).periodPrecision ?? 'month') : 'day');
const frame = { feature: 'px', card: 'px-soft', compact: 'px-flat', row: '' }[variant];
const hasTags = showKind || item.stage || item.draft || item.lang !== lang;
---

<article
  class:list={['entry-card', `v-${variant}`, frame, { 'px-lift': variant === 'feature' || variant === 'card' }]}
  data-kind={item.kind}
  lang={item.lang !== lang ? item.lang : undefined}
>
  {
    variant === 'feature' && (
      <div class="ec-window sky-window">
        <Sigil seed={item.key} chart twinkle />
      </div>
    )
  }
  {
    variant === 'row' && (
      <span class="ec-sigil sigil-chip sky-window">
        <Sigil seed={item.key} twinkle />
      </span>
    )
  }
  <div class="ec-body">
    {
      (variant === 'card' || hasTags) && (
        <div class="ec-top">
          {variant === 'card' && (
            <span class="ec-sigil sigil-chip sky-window">
              <Sigil seed={item.key} twinkle />
            </span>
          )}
          {hasTags && (
            <span class="ec-tags">
              {showKind && <span class="kind-tag">{kindLabel}</span>}
              {item.stage && <StageBadge stage={item.stage} lang={lang} />}
              {item.draft && <span class="badge-draft">{tr('meta.draft')}</span>}
              {item.lang !== lang && (
                <span class="ec-lang" title={tr('lang.onlyIn')}>
                  {item.lang.toUpperCase()}
                </span>
              )}
            </span>
          )}
        </div>
      )
    }
    <H class="ec-title">
      <a href={item.url}>{item.title}</a>
    </H>
    {variant !== 'compact' && <p class="ec-desc">{item.description}</p>}
    <p class="meta ec-meta">
      <span>
        <Icon name="calendar" size="12" />
        <time datetime={item.date.toISOString()}>{dateLabel}</time>
      </span>
      {
        item.kind !== 'work' && (
          <span>
            <Icon name="clock" size="12" /> {item.readingMinutes} {tr('meta.minRead')}
          </span>
        )
      }
    </p>
    {
      variant === 'feature' && (
        <span class="ec-more" aria-hidden="true">
          {tr('entry.read')} <Icon name="arrow-right" />
        </span>
      )
    }
  </div>
</article>

<style>
  .entry-card {
    position: relative;
    display: grid;
    align-items: start;
    min-width: 0;
  }
  .ec-body {
    display: grid;
    gap: 0.45rem;
    min-width: 0;
  }
  .ec-top {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }
  .ec-tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.6rem;
    min-width: 0;
  }
  .ec-lang {
    font-family: var(--font-label);
    font-size: 1rem;
    letter-spacing: 0.06em;
    line-height: 1.3;
    padding: 0 0.4em;
    color: var(--ink-3);
    box-shadow: inset 0 0 0 2px var(--line-strong);
  }
  .ec-title {
    font-size: var(--step-2);
    font-weight: 700;
    line-height: 1.08;
  }
  .ec-title a {
    color: var(--ink);
    text-decoration: none;
    background-image: linear-gradient(var(--pop), var(--pop));
    background-size: 0 4px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size 160ms steps(4, end);
  }
  .entry-card:hover .ec-title a,
  .ec-title a:focus-visible {
    background-size: 100% 4px;
  }
  /* Cả thẻ bấm được */
  .ec-title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .ec-desc {
    color: var(--ink-2);
    font-size: 0.97em;
    line-height: 1.65;
  }
  .ec-meta {
    margin-top: 0.15rem;
  }

  /* --- Nổi bật: cửa sổ chòm sao lớn bên trái --- */
  .v-feature {
    --hard: var(--kind-bright);
    --s: calc(var(--pu) * 2);
    grid-template-columns: minmax(9rem, 15rem) minmax(0, 1fr);
    gap: clamp(1.25rem, 3vw, 2.25rem);
    align-items: center;
    margin: var(--pu);
    padding: var(--card-pad);
    background: var(--bg-elev);
  }
  :global(:root[data-theme='dark']) .v-feature {
    --frame: color-mix(in srgb, var(--kind-bright) 70%, var(--frame-hi));
    --hard: #05031a;
  }
  .v-feature:hover {
    --s: calc(var(--pu) * 3);
  }
  .ec-window {
    aspect-ratio: 1;
    padding: 10%;
    box-shadow: inset 0 0 0 3px color-mix(in srgb, var(--kind-bright) 55%, transparent);
  }
  .v-feature .ec-body {
    gap: 0.6rem;
  }
  .v-feature .ec-title {
    font-size: var(--step-3);
    line-height: 1.02;
  }
  .v-feature .ec-desc {
    font-size: var(--step-0);
  }
  .ec-more {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 0.35rem;
    font-family: var(--font-pixel);
    font-weight: 700;
    font-size: 1.2rem;
    color: var(--accent);
    border-bottom: 3px solid currentColor;
  }
  .ec-more :global(.icon) {
    transition: transform 120ms var(--ease-px);
  }
  .v-feature:hover .ec-more :global(.icon) {
    transform: translateX(3px);
  }

  /* --- Thẻ lưới --- */
  .v-card {
    margin: var(--pu);
    padding: var(--card-pad);
    background: var(--bg-elev);
  }
  .v-card .ec-body {
    gap: 0.55rem;
  }
  .v-card .ec-top {
    margin-bottom: 0.2rem;
  }

  /* --- Dòng danh sách: phân cách bằng hàng chấm pixel --- */
  .v-row {
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-l);
    padding-block: var(--space-l);
    background: linear-gradient(90deg, var(--line-strong) 50%, transparent 0) top left / 8px 3px repeat-x;
  }
  .v-row .ec-sigil {
    width: 3.75rem;
    height: 3.75rem;
    margin-top: 0.2rem;
  }
  .v-row:hover .ec-sigil {
    box-shadow: inset 0 0 0 2px var(--kind-bright);
  }

  /* --- Gọn: liên quan / backlinks --- */
  .v-compact {
    margin: var(--pu);
    padding: 0.85rem 1rem 0.85rem 1.35rem;
    background:
      linear-gradient(var(--kind-bright), var(--kind-bright)) left / 5px 100% no-repeat,
      var(--bg-elev);
    transition: box-shadow 120ms var(--ease-px);
  }
  .v-compact:hover {
    --frame: var(--frame-hi);
  }
  .v-compact .ec-body {
    gap: 0.3rem;
  }
  .v-compact .ec-title {
    font-size: 1.4rem;
  }
  .v-compact .ec-meta {
    margin-top: 0;
  }

  @media (max-width: 720px) {
    .v-feature {
      grid-template-columns: 1fr;
    }
    .ec-window {
      width: 7.5rem;
      padding: 8px;
    }
  }
  @media (max-width: 560px) {
    .v-row {
      gap: var(--space-m);
    }
    .v-row .ec-sigil {
      width: 3rem;
      height: 3rem;
      padding: 4px;
    }
  }
</style>
