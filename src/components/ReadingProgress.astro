---

<div class="reading-progress" aria-hidden="true"><span></span></div>

<script>
  const bar = document.querySelector<HTMLElement>('.reading-progress span');
  if (bar && !CSS.supports('animation-timeline: scroll()')) {
    const update = () => {
      const h = document.documentElement;
      const max = h.scrollHeight - h.clientHeight;
      bar.style.transform = `scaleX(${max > 0 ? Math.min(1, h.scrollTop / max) : 0})`;
    };
    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
  }
</script>

<style>
  .reading-progress {
    position: fixed;
    inset: 0 0 auto 0;
    height: 3px;
    z-index: 60;
    pointer-events: none;
  }
  .reading-progress span {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, var(--work-bright), var(--star-bright));
    transform-origin: 0 50%;
    transform: scaleX(0);
    box-shadow: 0 0 10px var(--star-bright);
  }
  @supports (animation-timeline: scroll()) {
    .reading-progress span {
      animation: progress linear both;
      animation-timeline: scroll(root block);
    }
  }
  @keyframes progress {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
</style>
