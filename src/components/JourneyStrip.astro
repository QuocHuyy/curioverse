---
import Icon from './Icon.astro';
import { JOURNEY_ICONS } from './journey-icons';
import { formatDate, t, url, type Lang } from '~/i18n/utils';
import type { Milestone } from '~/lib/content';
interface Props {
  milestones: Milestone[];
  lang: Lang;
}
const { milestones, lang } = Astro.props;
const tr = t(lang);
const items = milestones.slice(0, 5);
const href = (link?: string) =>
  link ? (/^https?:/.test(link) || link.startsWith(import.meta.env.BASE_URL.replace(/\/$/, '') + '/') ? link : url(link)) : undefined;
---

<ol class="journey-strip">
  {
    items.map((m) => {
      const link = href(m.link);
      return (
        <li>
          <span class="js-dot" aria-hidden="true">
            <Icon name={JOURNEY_ICONS[m.kind]} size="12" />
          </span>
          <p class="js-date">{formatDate(m.date, lang, m.precision === 'day' ? 'month' : m.precision)}</p>
          <p class="js-title">{link ? <a href={link}>{m.title}</a> : m.title}</p>
          <p class="js-kind">{tr(`journey.${m.kind}`)}</p>
        </li>
      );
    })
  }
</ol>

<style>
  .journey-strip {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: var(--space-l);
    position: relative;
  }
  /* Con đường như bản đồ màn chơi */
  .journey-strip::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: calc(1.1rem - 2px);
    height: 4px;
    background: linear-gradient(90deg, var(--line-strong) 60%, transparent 0) 0 0 / 12px 4px repeat-x;
  }
  li {
    position: relative;
    display: grid;
    gap: 0.3rem;
    align-content: start;
  }
  .js-dot {
    --pu: 2px;
    --frame: var(--ink);
    --s: 2px;
    display: grid;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
    margin: 2px 0 0.6rem 2px;
    background: var(--bg-elev);
    color: var(--ink-2);
    box-shadow:
      0 -2px 0 0 var(--frame),
      0 2px 0 0 var(--frame),
      -2px 0 0 0 var(--frame),
      2px 0 0 0 var(--frame),
      4px 4px 0 0 var(--hard);
  }
  li:first-child .js-dot {
    background: var(--star-bright);
    color: #231a3b;
  }
  @media (prefers-reduced-motion: no-preference) {
    li:first-child .js-dot {
      animation: js-hop 1.4s steps(1, end) infinite;
    }
  }
  @keyframes js-hop {
    50% {
      transform: translateY(-3px);
    }
  }
  .js-date {
    font-family: var(--font-hud);
    font-size: 1.1rem;
    line-height: 1.2;
    color: var(--ink-3);
  }
  .js-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.45rem;
    line-height: 1.08;
  }
  .js-title a {
    color: var(--ink);
    text-decoration: none;
  }
  .js-title a:hover {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 3px;
  }
  .js-kind {
    justify-self: start;
    font-family: var(--font-hud);
    font-size: 1rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--star);
  }
  @media (max-width: 640px) {
    .journey-strip {
      grid-template-columns: 1fr;
      gap: var(--space-m);
      padding-left: 3rem;
    }
    .journey-strip::before {
      top: 0.5rem;
      bottom: 0.5rem;
      left: calc(1.1rem);
      right: auto;
      width: 4px;
      height: auto;
      background: linear-gradient(var(--line-strong) 60%, transparent 0) 0 0 / 4px 12px repeat-y;
    }
    .js-dot {
      position: absolute;
      left: -3rem;
      top: 0;
    }
  }
</style>
