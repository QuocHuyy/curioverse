---
/** Ghi chú bên lề kiểu sổ tay: trên màn hình rộng nằm ở lề phải, trên điện thoại nằm ngay trong dòng. */
---

<aside class="sidenote"><slot /></aside>

<style>
  .sidenote {
    font-size: var(--step--1);
    line-height: 1.6;
    color: var(--ink-3);
    padding: 0.6rem 0.9rem;
    border-left: 2px solid var(--star-bright);
    background: var(--star-tint);
    border-radius: 0 var(--radius-s) var(--radius-s) 0;
  }
  .sidenote :global(p + p) {
    margin-top: 0.5em;
  }
  @media (min-width: 1180px) {
    .sidenote {
      float: right;
      clear: right;
      width: 12.5rem;
      margin: 0.2rem -15.5rem 1rem 1rem !important;
      background: none;
      padding: 0 0 0 0.9rem;
      font-family: var(--font-display);
      font-style: italic;
      font-size: 0.92rem;
    }
  }
</style>
