---
/** Ghi chú bên lề kiểu sổ tay: trên màn hình rộng nằm ở lề phải, trên điện thoại nằm ngay trong dòng. */
---

<aside class="sidenote"><slot /></aside>

<style>
  .sidenote {
    font-size: var(--step--1);
    line-height: 1.6;
    color: var(--ink-3);
    padding: 0.6rem 0.9rem;
    background:
      linear-gradient(var(--star-bright), var(--star-bright)) left / 4px 100% no-repeat,
      var(--star-tint);
  }
  .sidenote :global(p + p) {
    margin-top: 0.5em;
  }
  @media (min-width: 1180px) {
    .sidenote {
      float: right;
      clear: right;
      width: 12.5rem;
      margin: 0.2rem -15.5rem 1rem 1rem !important;
      background: linear-gradient(var(--star-bright), var(--star-bright)) left / 4px 100% no-repeat;
      padding: 0 0 0 0.9rem;
      font-size: 0.88rem;
    }
  }
</style>
