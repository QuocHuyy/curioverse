---
/**
 * Bản đồ sao — đồ thị tương tác của mọi bài viết.
 * SVG được dựng sẵn lúc build (dùng được cả khi tắt JS); script chỉ thêm kéo/zoom/hover/lọc/tìm.
 */
import Icon from '../Icon.astro';
import StarGlyph from '../StarGlyph.astro';
import { EDGE_CLUSTER, getGraph, type GNode } from '~/lib/graph';
import { KINDS } from '~/lib/content';
import { starfield } from '~/lib/sigil';
import { cellsPath, discCells, sparkleCells, type Cell } from '~/lib/pixel';
import { fold, formatDate, t, type Lang } from '~/i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);
const graph = await getGraph(lang);
const { width: W, height: H } = graph;
const kindOf = new Map(graph.nodes.map((n) => [n.id, n.kind]));
const pos = new Map(graph.nodes.map((n) => [n.id, n]));
const counts = Object.fromEntries(KINDS.map((k) => [k, graph.nodes.filter((n) => n.kind === k).length]));

// Nhãn luôn hiện cho những ngôi sao "nổi bật"
const prominent = new Set(
  graph.nodes
    .slice()
    .sort((a, b) => Number(b.featured) - Number(a.featured) || b.degree - a.degree)
    .slice(0, Math.max(6, Math.round(graph.nodes.length * 0.25)))
    .map((n) => n.id),
);

const adj: Record<string, string[]> = {};
for (const e of graph.edges) {
  (adj[e.source] ??= []).push(e.target);
  (adj[e.target] ??= []).push(e.source);
}
const meta = Object.fromEntries(
  graph.nodes.map((n) => [
    n.id,
    {
      title: n.title,
      kind: tr(`kind.${n.kind}.one`),
      date: formatDate(new Date(n.date), lang, n.datePrecision),
      desc: n.description,
      url: n.url,
      stage: n.stage ? tr(`stage.${n.stage}`) : '',
      draft: n.draft,
    },
  ]),
);
const bg = starfield(`universe-${lang}`, 220, W, H);
const groups = [
  ...graph.clusters.map((c) => ({ label: c.label, nodes: graph.nodes.filter((n) => n.cluster === c.id) })),
  { label: tr('universe.edge'), nodes: graph.nodes.filter((n) => n.cluster === EDGE_CLUSTER) },
].filter((g) => g.nodes.length);

// Hình pixel cho từng loại sao (ô lưới PX đơn vị, tâm tại toạ độ nút)
const PX = 2.5;
const at = (n: GNode, cells: Cell[]) => cellsPath(cells, PX, n.x - PX / 2, n.y - PX / 2);
const ringCellsFor = (r: number) => {
  const out = new Map<string, Cell>();
  for (let i = 0; i < 72; i++) {
    const t = (i / 72) * Math.PI * 2;
    const ex = r * 1.9 * Math.cos(t);
    const ey = r * 0.7 * Math.sin(t);
    const a = (-22 * Math.PI) / 180;
    const x = Math.round(ex * Math.cos(a) - ey * Math.sin(a));
    const y = Math.round(ex * Math.sin(a) + ey * Math.cos(a));
    if (x * x + y * y > r * r) out.set(`${x},${y}`, [x, y]);
  }
  return [...out.values()];
};
const nodeShape = (n: GNode) => {
  const r = Math.max(2, Math.round(n.r / PX));
  if (n.kind === 'stories') return { type: 'star' as const, d: at(n, sparkleCells(0, 0, Math.round(r * 1.7), r >= 3 ? 2 : 1)) };
  if (n.kind === 'work') return { type: 'planet' as const, d: at(n, discCells(0, 0, r)), ring: at(n, ringCellsFor(r)) };
  if (n.stage === 'nebula') {
    const cloud = discCells(0, 0, Math.round(r * 2.4)).filter(([x, y]) => (x + y) % 2 === 0);
    return { type: 'nebula' as const, d: at(n, discCells(0, 0, Math.max(1, Math.round(r * 0.5)))), cloud: at(n, cloud) };
  }
  return { type: 'dot' as const, d: at(n, discCells(0, 0, r)) };
};
const halo = (n: GNode) => at(n, discCells(0, 0, Math.round((n.r * 3) / PX)).filter(([x, y]) => (x + y) % 2 === 0));
const short = (s: string) => (s.length > 38 ? s.slice(0, 36) + '…' : s);
---

<section class="universe" data-universe data-match-label={tr('universe.matches')} aria-label={tr('universe.title')}>
  <div class="u-toolbar">
    <div class="u-filters" role="group" aria-label={tr('universe.filter')}>
      {
        KINDS.map((k) => (
          <label class="u-toggle" data-kind={k}>
            <input type="checkbox" checked data-u-kind={k} />
            <span class="u-swatch" aria-hidden="true" />
            {tr(`kind.${k}`)}
            <span class="u-count">{counts[k]}</span>
          </label>
        ))
      }
    </div>
    <label class="u-search">
      <Icon name="search" />
      <span class="visually-hidden">{tr('universe.search')}</span>
      <input type="search" placeholder={tr('universe.search')} data-u-search autocomplete="off" spellcheck="false" />
      <span class="u-matches" aria-live="polite"></span>
    </label>
  </div>

  <div class="u-stage px" data-u-stage>
    <svg class="u-svg" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid meet" data-u-svg shape-rendering="crispEdges" role="group" aria-label={tr('universe.lead')}>
      <g class="u-viewport" data-u-viewport>
        <g class="u-chart" aria-hidden="true">
          {[0.18, 0.34, 0.5, 0.66].map((f) => <ellipse cx={W / 2} cy={H / 2} rx={W * f * 0.75} ry={H * f * 0.75} />)}
          {
            [0, 30, 60, 90, 120, 150].map((deg) => {
              const a = (deg * Math.PI) / 180;
              const rx = W * 0.5;
              const ry = H * 0.5;
              return <line x1={W / 2 - Math.cos(a) * rx} y1={H / 2 - Math.sin(a) * ry} x2={W / 2 + Math.cos(a) * rx} y2={H / 2 + Math.sin(a) * ry} />;
            })
          }
        </g>
        <g class="u-bg" aria-hidden="true">
          {bg.map((d) => <rect x={d.x} y={d.y} width={d.r > 0.6 ? 3 : 2} height={d.r > 0.6 ? 3 : 2} style={`opacity:${d.o};--d:${d.d}s`} />)}
        </g>
        <g class="u-edges" aria-hidden="true">
          {
            graph.edges.map((e) => {
              const a = pos.get(e.source)!;
              const b = pos.get(e.target)!;
              return (
                <line
                  class:list={['u-edge', e.strong ? 'strong' : 'weak']}
                  data-a={e.source}
                  data-b={e.target}
                  data-ka={kindOf.get(e.source)}
                  data-kb={kindOf.get(e.target)}
                  x1={a.x}
                  y1={a.y}
                  x2={b.x}
                  y2={b.y}
                />
              );
            })
          }
        </g>
        <g class="u-clusters" aria-hidden="true">
          {graph.clusters.map((c) => <text x={c.x} y={c.y} text-anchor="middle" class="u-cluster">{c.label}</text>)}
        </g>
        <g class="u-nodes">
          {
            graph.nodes.map((n, i) => {
              const shape = nodeShape(n);
              return (
                <a
                  href={n.url}
                  class:list={['u-node', { always: prominent.has(n.id) }]}
                  data-id={n.id}
                  data-kind={n.kind}
                  data-search={fold(`${n.title} ${n.tags.join(' ')}`)}
                  aria-label={`${tr(`kind.${n.kind}.one`)}: ${n.title}`}
                >
                  <circle class="u-hit" cx={n.x} cy={n.y} r={Math.max(n.r * 2.4, 14)} />
                  <path class="u-halo" d={halo(n)} />
                  {shape.type === 'nebula' && <path class="u-nebula" d={shape.cloud} />}
                  {shape.type === 'planet' && <path class="u-ring" d={shape.ring} />}
                  <path class="u-core" d={shape.d} style={`--d:${((i * 0.53) % 5).toFixed(2)}s`} />
                  <text class="u-label" x={n.x} y={n.y + n.r + 15} text-anchor="middle">
                    {short(n.title)}
                  </text>
                </a>
              );
            })
          }
        </g>
      </g>
    </svg>

    <div class="u-controls px" role="group">
      <button type="button" class="icon-btn" data-u-zoom="in" aria-label={tr('universe.zoomIn')} title={tr('universe.zoomIn')}><Icon name="plus" size="18" /></button>
      <button type="button" class="icon-btn" data-u-zoom="out" aria-label={tr('universe.zoomOut')} title={tr('universe.zoomOut')}><Icon name="minus" size="18" /></button>
      <button type="button" class="icon-btn" data-u-zoom="reset" aria-label={tr('universe.reset')} title={tr('universe.reset')}><Icon name="focus" size="18" /></button>
    </div>

    <div class="u-legend" aria-hidden="true">
      <span data-kind="stories"><svg viewBox="0 0 9 9" shape-rendering="crispEdges"><path d={cellsPath(sparkleCells(4, 4, 4, 1))} /></svg>{tr('kind.stories.one')}</span>
      <span data-kind="work"><svg viewBox="0 0 9 9" shape-rendering="crispEdges"><path d={cellsPath(discCells(4, 4, 2))} /><path class="lg-ring" d={cellsPath([[0, 6], [1, 6], [1, 5], [7, 3], [8, 2], [7, 2]])} /></svg>{tr('kind.work.one')}</span>
      <span data-kind="notes"><StarGlyph stage="protostar" />{tr('kind.notes.one')}</span>
      <span class="u-stats">{graph.nodes.length} {tr('universe.stars')} · {graph.edges.length} {tr('universe.links')}</span>
    </div>

    <div class="u-tooltip px" data-u-tooltip hidden>
      <p class="ut-kind"></p>
      <p class="ut-title"></p>
      <p class="ut-desc"></p>
      <a class="ut-open" href="#">{tr('universe.open')} <Icon name="arrow-right" /></a>
    </div>
    <p class="u-hint" data-u-hint>{tr('universe.wheelHint')}</p>
  </div>

  <details class="u-list px">
    <summary><Icon name="list" /> {tr('universe.list')}</summary>
    <div class="u-list-grid">
      {
        groups.map((g) => (
          <section>
            <h3>{g.label}</h3>
            <ul>
              {g.nodes.map((n) => (
                <li data-kind={n.kind}>
                  <a href={n.url}>{n.title}</a>
                  <span>{tr(`kind.${n.kind}.one`)}</span>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </details>

  <script type="application/json" data-u-data set:html={JSON.stringify({ adj, meta })} />
</section>

<script>
  import { initUniverse } from './universe-client';
  document.querySelectorAll<HTMLElement>('[data-universe]').forEach(initUniverse);
</script>

<style>
  .universe {
    display: grid;
    gap: var(--space-l);
  }
  .u-toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s) var(--space-m);
    align-items: center;
    justify-content: space-between;
  }
  .u-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .u-toggle {
    --frame: var(--ink);
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    margin: 2px;
    padding: 0.25em 0.75em;
    background: var(--bg-elev);
    font-family: var(--font-pixel);
    font-size: 1.15rem;
    font-weight: 600;
    cursor: pointer;
    user-select: none;
    box-shadow:
      0 -2px 0 0 var(--frame),
      0 2px 0 0 var(--frame),
      -2px 0 0 0 var(--frame),
      2px 0 0 0 var(--frame),
      4px 4px 0 0 var(--kind-bright);
    transition:
      opacity var(--dur),
      transform 100ms var(--ease-px);
  }
  .u-toggle:hover {
    transform: translate(-1px, -1px);
  }
  .u-toggle:has(input:focus-visible) {
    outline: 3px solid var(--focus);
    outline-offset: 4px;
  }
  .u-toggle input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .u-toggle:has(input:not(:checked)) {
    opacity: 0.5;
    box-shadow:
      0 -2px 0 0 var(--frame),
      0 2px 0 0 var(--frame),
      -2px 0 0 0 var(--frame),
      2px 0 0 0 var(--frame);
  }
  .u-toggle:has(input:not(:checked)) .u-swatch {
    background: transparent;
  }
  .u-swatch {
    width: 0.7rem;
    height: 0.7rem;
    background: var(--kind-bright);
    box-shadow: inset 0 0 0 2px var(--kind-bright);
  }
  .u-count {
    font-family: var(--font-hud);
    font-weight: 400;
    color: var(--ink-3);
  }
  .u-search {
    --frame: var(--ink);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 2px;
    padding: 0.35rem 0.8rem;
    background: var(--bg-elev);
    color: var(--ink-3);
    min-width: min(100%, 18rem);
    box-shadow:
      0 -2px 0 0 var(--frame),
      0 2px 0 0 var(--frame),
      -2px 0 0 0 var(--frame),
      2px 0 0 0 var(--frame);
  }
  .u-search:focus-within {
    outline: 3px solid var(--focus);
    outline-offset: 4px;
  }
  .u-search input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    font-family: var(--font-pixel);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--ink);
    caret-color: var(--pop);
  }
  .u-matches {
    font-family: var(--font-hud);
    font-size: 1.05rem;
    white-space: nowrap;
  }

  /* Sân khấu: cửa sổ trời đêm (cả ban ngày cũng là "bầu trời" màu kem) */
  .u-stage {
    --s: calc(var(--pu) * 3);
    position: relative;
    height: clamp(440px, 72vh, 780px);
    margin: var(--pu);
    overflow: hidden;
    background:
      linear-gradient(var(--sky-grid) 1px, transparent 1px) 0 0 / 24px 24px,
      linear-gradient(90deg, var(--sky-grid) 1px, transparent 1px) 0 0 / 24px 24px,
      linear-gradient(to bottom, color-mix(in srgb, var(--sky-2) 45%, var(--bg-elev)), var(--bg-elev) 70%);
  }
  :global(:root[data-theme='dark']) .u-stage {
    background:
      linear-gradient(var(--sky-grid) 1px, transparent 1px) 0 0 / 24px 24px,
      linear-gradient(90deg, var(--sky-grid) 1px, transparent 1px) 0 0 / 24px 24px,
      linear-gradient(to bottom, #070519 0 18%, #0d0a2a 18% 36%, #150f3c 36% 56%, #1f1450 56% 76%, #2b1862 76%);
  }
  .u-svg {
    width: 100%;
    height: 100%;
    touch-action: none;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
    --px: 1;
  }
  .u-svg.dragging {
    cursor: grabbing;
  }
  .u-chart {
    fill: none;
    stroke: var(--sky-grid);
    stroke-width: 2;
    stroke-dasharray: 2 6;
  }
  :global(:root[data-theme='light']) .u-chart {
    stroke: rgba(35, 26, 59, 0.12);
  }
  .u-chart,
  .u-edge {
    vector-effect: non-scaling-stroke;
  }
  .u-chart :global(*) {
    vector-effect: non-scaling-stroke;
  }
  .u-bg rect {
    fill: var(--sky-star);
  }
  :global(:root[data-theme='light']) .u-bg rect {
    opacity: 0.16 !important;
  }
  .u-edge {
    stroke: var(--sky-line);
    stroke-width: 2;
    stroke-linecap: square;
    transition: opacity 200ms;
  }
  .u-edge.weak {
    stroke-dasharray: 3 6;
  }
  .u-edge.strong {
    stroke: var(--sky-line-strong);
    stroke-width: 2.5;
  }
  .u-cluster {
    font-family: var(--font-hud);
    font-size: calc(20px * var(--px));
    fill: var(--ink-3);
    opacity: 0.9;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    pointer-events: none;
  }
  .u-node {
    outline: none;
    transition: opacity 200ms;
    -webkit-user-drag: none;
  }
  .u-hit {
    fill: transparent;
  }
  .u-halo {
    fill: var(--kind-bright);
    opacity: 0;
    transition: opacity 150ms steps(2, end);
  }
  .u-core {
    fill: var(--kind-bright);
    transition: transform 150ms var(--ease-px);
    transform-box: fill-box;
    transform-origin: center;
  }
  .u-ring {
    fill: var(--kind-bright);
    opacity: 0.85;
  }
  .u-nebula {
    fill: var(--kind-bright);
    opacity: 0.45;
  }
  :global(:root[data-theme='dark']) .u-core {
    filter: drop-shadow(0 0 4px var(--kind-bright));
  }
  :global(:root[data-theme='light']) .u-core,
  :global(:root[data-theme='light']) .u-ring {
    fill: var(--kind);
  }
  :global(:root[data-theme='light']) [data-kind='stories'] .u-core {
    fill: #e89a00;
  }
  .u-label {
    font-family: var(--font-pixel);
    font-size: calc(17px * var(--px));
    font-weight: 700;
    fill: var(--ink-2);
    paint-order: stroke;
    stroke: var(--bg-elev);
    stroke-width: calc(5px * var(--px));
    stroke-linejoin: miter;
    opacity: 0;
    pointer-events: none;
    transition: opacity 150ms;
  }
  :global(:root[data-theme='dark']) .u-label {
    stroke: #0b0820;
  }
  .u-node.always .u-label,
  .u-svg.zoomed .u-label {
    opacity: 1;
  }
  .u-node:hover .u-label,
  .u-node:focus-visible .u-label,
  .u-node.is-near .u-label {
    opacity: 1;
    fill: var(--ink);
  }
  .u-node:hover .u-halo,
  .u-node:focus-visible .u-halo,
  .u-node.is-active .u-halo {
    opacity: 0.35;
  }
  .u-node:hover .u-core,
  .u-node:focus-visible .u-core,
  .u-node.is-active .u-core {
    transform: scale(1.35);
  }
  .u-node:focus-visible .u-hit {
    stroke: var(--focus);
    stroke-width: 2;
    stroke-dasharray: 3 3;
    vector-effect: non-scaling-stroke;
  }
  .u-svg.has-focus .u-node:not(.is-near) {
    opacity: 0.22;
  }
  .u-svg.has-focus .u-edge:not(.is-near) {
    opacity: 0.12;
  }
  .u-svg.has-focus .u-edge.is-near {
    stroke: var(--pop);
    stroke-dasharray: none;
    opacity: 1;
  }
  .u-svg.searching .u-node:not(.is-match) {
    opacity: 0.15;
  }
  .u-svg.searching .u-node.is-match .u-label {
    opacity: 1;
  }
  .u-svg.searching .u-node.is-match .u-halo {
    opacity: 0.4;
  }
  .u-svg.searching .u-edge {
    opacity: 0.2;
  }
  .u-svg[data-hide-stories] [data-kind='stories'],
  .u-svg[data-hide-stories] .u-edge:is([data-ka='stories'], [data-kb='stories']),
  .u-svg[data-hide-work] [data-kind='work'],
  .u-svg[data-hide-work] .u-edge:is([data-ka='work'], [data-kb='work']),
  .u-svg[data-hide-notes] [data-kind='notes'],
  .u-svg[data-hide-notes] .u-edge:is([data-ka='notes'], [data-kb='notes']) {
    display: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(:root[data-theme='dark']) .u-bg rect {
      animation: u-twinkle 5s steps(1, end) infinite;
      animation-delay: var(--d);
    }
  }
  @keyframes u-twinkle {
    50% {
      opacity: 0.12;
    }
  }

  .u-controls {
    --pu: 2px;
    --s: 4px;
    position: absolute;
    right: 0.9rem;
    top: 0.9rem;
    display: grid;
    gap: 0.2rem;
    padding: 0.2rem;
    background: var(--bg-elev);
  }
  .u-controls .icon-btn {
    min-width: 2.3rem;
    height: 2.3rem;
    padding: 0;
  }
  .u-legend {
    position: absolute;
    left: 0.9rem;
    bottom: 0.75rem;
    right: 0.9rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1.1rem;
    align-items: center;
    font-family: var(--font-hud);
    font-size: 1.05rem;
    letter-spacing: 0.04em;
    color: var(--ink-3);
    pointer-events: none;
  }
  .u-legend > span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .u-legend svg {
    width: 14px;
    height: 14px;
    fill: var(--kind-bright);
  }
  :global(:root[data-theme='light']) .u-legend svg {
    fill: var(--kind);
  }
  .u-stats {
    margin-left: auto;
  }
  .u-tooltip {
    --pu: 3px;
    --s: 6px;
    position: absolute;
    z-index: 3;
    width: min(18rem, calc(100% - 1.5rem));
    padding: 0.85rem 1rem;
    background: var(--bg-elev);
    pointer-events: none;
    display: grid;
    gap: 0.3rem;
  }
  .u-tooltip[hidden] {
    display: none;
  }
  .u-tooltip.pinned {
    pointer-events: auto;
  }
  .ut-kind {
    font-family: var(--font-hud);
    font-size: 1.02rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--kind);
  }
  .ut-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.45rem;
    line-height: 1.08;
  }
  .ut-desc {
    font-size: var(--step--1);
    color: var(--ink-2);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .ut-open {
    display: none;
    font-family: var(--font-pixel);
    font-size: 1.15rem;
    font-weight: 700;
    align-items: center;
    gap: 0.4rem;
