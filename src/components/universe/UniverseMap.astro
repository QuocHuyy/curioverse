---
/**
 * Bản đồ sao — đồ thị tương tác của mọi bài viết.
 * SVG được dựng sẵn lúc build (dùng được cả khi tắt JS); script chỉ thêm kéo/zoom/hover/lọc/tìm.
 */
import Icon from '../Icon.astro';
import StarGlyph from '../StarGlyph.astro';
import { EDGE_CLUSTER, getGraph, type GNode } from '~/lib/graph';
import { KINDS } from '~/lib/content';
import { sparklePath, starfield } from '~/lib/sigil';
import { fold, formatDate, t, type Lang } from '~/i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);
const graph = await getGraph(lang);
const { width: W, height: H } = graph;
const kindOf = new Map(graph.nodes.map((n) => [n.id, n.kind]));
const pos = new Map(graph.nodes.map((n) => [n.id, n]));
const counts = Object.fromEntries(KINDS.map((k) => [k, graph.nodes.filter((n) => n.kind === k).length]));

// Nhãn luôn hiện cho những ngôi sao "nổi bật"
const prominent = new Set(
  graph.nodes
    .slice()
    .sort((a, b) => Number(b.featured) - Number(a.featured) || b.degree - a.degree)
    .slice(0, Math.max(6, Math.round(graph.nodes.length * 0.25)))
    .map((n) => n.id),
);

const adj: Record<string, string[]> = {};
for (const e of graph.edges) {
  (adj[e.source] ??= []).push(e.target);
  (adj[e.target] ??= []).push(e.source);
}
const meta = Object.fromEntries(
  graph.nodes.map((n) => [
    n.id,
    {
      title: n.title,
      kind: tr(`kind.${n.kind}.one`),
      date: formatDate(new Date(n.date), lang, n.datePrecision),
      desc: n.description,
      url: n.url,
      stage: n.stage ? tr(`stage.${n.stage}`) : '',
      draft: n.draft,
    },
  ]),
);
const bg = starfield(`universe-${lang}`, 220, W, H);
const groups = [
  ...graph.clusters.map((c) => ({ label: c.label, nodes: graph.nodes.filter((n) => n.cluster === c.id) })),
  { label: tr('universe.edge'), nodes: graph.nodes.filter((n) => n.cluster === EDGE_CLUSTER) },
].filter((g) => g.nodes.length);

const nodeShape = (n: GNode) => {
  if (n.kind === 'stories') return { type: 'star' as const, d: sparklePath(n.x, n.y, n.r * 1.9, 0.2) };
  if (n.kind === 'work') return { type: 'planet' as const };
  return { type: n.stage === 'nebula' ? ('nebula' as const) : ('dot' as const) };
};
const short = (s: string) => (s.length > 38 ? s.slice(0, 36) + '…' : s);
---

<section class="universe" data-universe data-match-label={tr('universe.matches')} aria-label={tr('universe.title')}>
  <div class="u-toolbar">
    <div class="u-filters" role="group" aria-label={tr('universe.filter')}>
      {
        KINDS.map((k) => (
          <label class="u-toggle" data-kind={k}>
            <input type="checkbox" checked data-u-kind={k} />
            <span class="u-swatch" aria-hidden="true" />
            {tr(`kind.${k}`)}
            <span class="u-count">{counts[k]}</span>
          </label>
        ))
      }
    </div>
    <label class="u-search">
      <Icon name="search" />
      <span class="visually-hidden">{tr('universe.search')}</span>
      <input type="search" placeholder={tr('universe.search')} data-u-search autocomplete="off" spellcheck="false" />
      <span class="u-matches" aria-live="polite"></span>
    </label>
  </div>

  <div class="u-stage" data-u-stage>
    <svg class="u-svg" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid meet" data-u-svg role="group" aria-label={tr('universe.lead')}>
      <defs>
        <radialGradient id="u-nebula">
          <stop offset="0" style="stop-color: var(--note-bright); stop-opacity: 0.9" />
          <stop offset=".45" style="stop-color: var(--note-bright); stop-opacity: 0.35" />
          <stop offset="1" style="stop-color: var(--note-bright); stop-opacity: 0" />
        </radialGradient>
      </defs>
      <g class="u-viewport" data-u-viewport>
        <g class="u-chart" aria-hidden="true">
          {[0.18, 0.34, 0.5, 0.66].map((f) => <ellipse cx={W / 2} cy={H / 2} rx={W * f * 0.75} ry={H * f * 0.75} />)}
          {
            [0, 30, 60, 90, 120, 150].map((deg) => {
              const a = (deg * Math.PI) / 180;
              const rx = W * 0.5;
              const ry = H * 0.5;
              return <line x1={W / 2 - Math.cos(a) * rx} y1={H / 2 - Math.sin(a) * ry} x2={W / 2 + Math.cos(a) * rx} y2={H / 2 + Math.sin(a) * ry} />;
            })
          }
        </g>
        <g class="u-bg" aria-hidden="true">
          {bg.map((d) => <circle cx={d.x} cy={d.y} r={d.r * 1.4} style={`opacity:${d.o};--d:${d.d}s`} />)}
        </g>
        <g class="u-edges" aria-hidden="true">
          {
            graph.edges.map((e) => {
              const a = pos.get(e.source)!;
              const b = pos.get(e.target)!;
              return (
                <line
                  class:list={['u-edge', e.strong ? 'strong' : 'weak']}
                  data-a={e.source}
                  data-b={e.target}
                  data-ka={kindOf.get(e.source)}
                  data-kb={kindOf.get(e.target)}
                  x1={a.x}
                  y1={a.y}
                  x2={b.x}
                  y2={b.y}
                />
              );
            })
          }
        </g>
        <g class="u-clusters" aria-hidden="true">
          {graph.clusters.map((c) => <text x={c.x} y={c.y} text-anchor="middle" class="u-cluster">{c.label}</text>)}
        </g>
        <g class="u-nodes">
          {
            graph.nodes.map((n, i) => {
              const shape = nodeShape(n);
              return (
                <a
                  href={n.url}
                  class:list={['u-node', { always: prominent.has(n.id) }]}
                  data-id={n.id}
                  data-kind={n.kind}
                  data-search={fold(`${n.title} ${n.tags.join(' ')}`)}
                  aria-label={`${tr(`kind.${n.kind}.one`)}: ${n.title}`}
                >
                  <circle class="u-hit" cx={n.x} cy={n.y} r={Math.max(n.r * 2.4, 14)} />
                  <circle class="u-halo" cx={n.x} cy={n.y} r={n.r * 3.2} />
                  {shape.type === 'star' && <path class="u-core" d={shape.d} style={`--d:${(i * 0.53) % 5}s`} />}
                  {shape.type === 'planet' && (
                    <>
                      <circle class="u-core" cx={n.x} cy={n.y} r={n.r} style={`--d:${(i * 0.53) % 5}s`} />
                      <ellipse class="u-ring" cx={n.x} cy={n.y} rx={n.r * 1.9} ry={n.r * 0.7} transform={`rotate(-22 ${n.x} ${n.y})`} />
                    </>
                  )}
                  {shape.type === 'dot' && <circle class="u-core" cx={n.x} cy={n.y} r={n.r} style={`--d:${(i * 0.53) % 5}s`} />}
                  {shape.type === 'nebula' && (
                    <>
                      <circle class="u-nebula" cx={n.x} cy={n.y} r={n.r * 2.6} />
                      <circle class="u-core" cx={n.x} cy={n.y} r={n.r * 0.55} />
                    </>
                  )}
                  <text class="u-label" x={n.x} y={n.y + n.r + 15} text-anchor="middle">
                    {short(n.title)}
                  </text>
                </a>
              );
            })
          }
        </g>
      </g>
    </svg>

    <div class="u-controls" role="group">
      <button type="button" class="icon-btn" data-u-zoom="in" aria-label={tr('universe.zoomIn')} title={tr('universe.zoomIn')}><Icon name="plus" size="18" /></button>
      <button type="button" class="icon-btn" data-u-zoom="out" aria-label={tr('universe.zoomOut')} title={tr('universe.zoomOut')}><Icon name="minus" size="18" /></button>
      <button type="button" class="icon-btn" data-u-zoom="reset" aria-label={tr('universe.reset')} title={tr('universe.reset')}><Icon name="focus" size="18" /></button>
    </div>

    <div class="u-legend" aria-hidden="true">
      <span data-kind="stories"><svg viewBox="0 0 16 16"><path d={sparklePath(8, 8, 7)} /></svg>{tr('kind.stories.one')}</span>
      <span data-kind="work"><svg viewBox="0 0 16 16"><circle cx="8" cy="8" r="3.6" /><ellipse cx="8" cy="8" rx="7" ry="2.6" transform="rotate(-22 8 8)" /></svg>{tr('kind.work.one')}</span>
      <span data-kind="notes"><StarGlyph stage="protostar" />{tr('kind.notes.one')}</span>
      <span class="u-stats">{graph.nodes.length} {tr('universe.stars')} · {graph.edges.length} {tr('universe.links')}</span>
    </div>

    <div class="u-tooltip" data-u-tooltip hidden>
      <p class="ut-kind"></p>
      <p class="ut-title"></p>
      <p class="ut-desc"></p>
      <a class="ut-open" href="#">{tr('universe.open')} <Icon name="arrow-right" /></a>
    </div>
    <p class="u-hint" data-u-hint>{tr('universe.wheelHint')}</p>
  </div>

  <details class="u-list">
    <summary><Icon name="list" /> {tr('universe.list')}</summary>
    <div class="u-list-grid">
      {
        groups.map((g) => (
          <section>
            <h3>{g.label}</h3>
            <ul>
              {g.nodes.map((n) => (
                <li data-kind={n.kind}>
                  <a href={n.url}>{n.title}</a>
                  <span>{tr(`kind.${n.kind}.one`)}</span>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </details>

  <script type="application/json" data-u-data set:html={JSON.stringify({ adj, meta })} />
</section>

<script>
  import { initUniverse } from './universe-client';
  document.querySelectorAll<HTMLElement>('[data-universe]').forEach(initUniverse);
</script>

<style>
  .universe {
    display: grid;
    gap: var(--space-m);
  }
  .u-toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s) var(--space-m);
    align-items: center;
    justify-content: space-between;
  }
  .u-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .u-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    padding: 0.3em 0.8em;
    border-radius: var(--radius-pill);
    border: 1px solid var(--line);
    background: var(--bg-elev);
    font-size: var(--step--1);
    cursor: pointer;
    user-select: none;
    transition:
      opacity var(--dur),
      border-color var(--dur);
  }
  .u-toggle:hover {
    border-color: var(--line-strong);
  }
  .u-toggle:has(input:focus-visible) {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }
  .u-toggle input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .u-toggle:has(input:not(:checked)) {
    opacity: 0.5;
  }
  .u-toggle:has(input:not(:checked)) .u-swatch {
    background: transparent;
  }
  .u-swatch {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    background: var(--kind-bright);
    border: 1.5px solid var(--kind-bright);
  }
  .u-count {
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }
  .u-search {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.9rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--line);
    background: var(--bg-elev);
    color: var(--ink-3);
    min-width: min(100%, 17rem);
  }
  .u-search:focus-within {
    border-color: var(--line-strong);
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }
  .u-search input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    font-size: var(--step--1);
    color: var(--ink);
  }
  .u-matches {
    font-size: 0.75rem;
    white-space: nowrap;
  }

  .u-stage {
    position: relative;
    height: clamp(440px, 72vh, 780px);
    border-radius: var(--radius-l);
    border: 1px solid var(--line);
    overflow: hidden;
    background:
      radial-gradient(ellipse at 50% 50%, color-mix(in srgb, var(--star-tint) 60%, transparent), transparent 65%),
      var(--bg-elev);
  }
  :global(:root[data-theme='dark']) .u-stage {
    background:
      radial-gradient(ellipse 60% 50% at 30% 30%, rgba(86, 100, 212, 0.22), transparent 70%),
      radial-gradient(ellipse 50% 40% at 75% 70%, rgba(245, 194, 107, 0.08), transparent 70%),
      radial-gradient(ellipse at 50% 50%, #10173a, #070a16 75%);
    border-color: #1b2347;
  }
  .u-svg {
    width: 100%;
    height: 100%;
    touch-action: none;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
    --px: 1;
  }
  .u-svg.dragging {
    cursor: grabbing;
  }
  .u-chart {
    fill: none;
    stroke: var(--sky-grid);
    stroke-width: 1;
  }
  .u-chart,
  .u-edge,
  .u-ring {
    vector-effect: non-scaling-stroke;
  }
  .u-chart :global(*) {
    vector-effect: non-scaling-stroke;
  }
  .u-bg circle {
    fill: var(--sky-star);
  }
  :global(:root[data-theme='light']) .u-bg circle {
    opacity: 0.16 !important;
  }
  .u-edge {
    stroke: var(--sky-line);
    stroke-width: 1;
    transition: opacity 200ms;
  }
  .u-edge.weak {
    stroke-dasharray: 3 5;
  }
  .u-edge.strong {
    stroke: var(--sky-line-strong);
    stroke-width: 1.3;
  }
  .u-cluster {
    font-family: var(--font-display);
    font-style: italic;
    font-size: calc(15px * var(--px));
    fill: var(--ink-3);
    opacity: 0.85;
    letter-spacing: 0.02em;
    pointer-events: none;
  }
  .u-node {
    outline: none;
    transition: opacity 200ms;
    -webkit-user-drag: none;
  }
  .u-hit {
    fill: transparent;
  }
  .u-halo {
    fill: var(--kind-bright);
    opacity: 0;
    transition: opacity 200ms;
  }
  .u-core {
    fill: var(--kind-bright);
    transition: transform 250ms var(--ease-out);
    transform-box: fill-box;
    transform-origin: center;
  }
  .u-ring {
    fill: none;
    stroke: var(--kind-bright);
    stroke-width: 1.2;
    opacity: 0.8;
  }
  .u-nebula {
    color: var(--kind-bright);
    fill: url(#u-nebula);
  }
  :global(:root[data-theme='dark']) .u-core {
    filter: drop-shadow(0 0 4px var(--kind-bright));
  }
  :global(:root[data-theme='light']) [data-kind='notes'] .u-core {
    fill: var(--note);
  }
  .u-label {
    font-family: var(--font-body);
    font-size: calc(12.5px * var(--px));
    font-weight: 500;
    fill: var(--ink-2);
    paint-order: stroke;
    stroke: var(--bg-elev);
    stroke-width: calc(4px * var(--px));
    stroke-linejoin: round;
    opacity: 0;
    pointer-events: none;
    transition: opacity 200ms;
  }
  :global(:root[data-theme='dark']) .u-label {
    stroke: #0b1027;
  }
  .u-node.always .u-label,
  .u-svg.zoomed .u-label {
    opacity: 1;
  }
  .u-node:hover .u-label,
  .u-node:focus-visible .u-label,
  .u-node.is-near .u-label {
    opacity: 1;
    fill: var(--ink);
  }
  .u-node:hover .u-halo,
  .u-node:focus-visible .u-halo,
  .u-node.is-active .u-halo {
    opacity: 0.16;
  }
  .u-node:hover .u-core,
  .u-node:focus-visible .u-core,
  .u-node.is-active .u-core {
    transform: scale(1.35);
  }
  .u-node:focus-visible .u-hit {
    stroke: var(--focus);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }
  .u-svg.has-focus .u-node:not(.is-near) {
    opacity: 0.22;
  }
  .u-svg.has-focus .u-edge:not(.is-near) {
    opacity: 0.12;
  }
  .u-svg.has-focus .u-edge.is-near {
    stroke: var(--star-bright);
    stroke-dasharray: none;
    opacity: 0.9;
  }
  .u-svg.searching .u-node:not(.is-match) {
    opacity: 0.15;
  }
  .u-svg.searching .u-node.is-match .u-label {
    opacity: 1;
  }
  .u-svg.searching .u-node.is-match .u-halo {
    opacity: 0.2;
  }
  .u-svg.searching .u-edge {
    opacity: 0.2;
  }
  .u-svg[data-hide-stories] [data-kind='stories'],
  .u-svg[data-hide-stories] .u-edge:is([data-ka='stories'], [data-kb='stories']),
  .u-svg[data-hide-work] [data-kind='work'],
  .u-svg[data-hide-work] .u-edge:is([data-ka='work'], [data-kb='work']),
  .u-svg[data-hide-notes] [data-kind='notes'],
  .u-svg[data-hide-notes] .u-edge:is([data-ka='notes'], [data-kb='notes']) {
    display: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(:root[data-theme='dark']) .u-bg circle {
      animation: u-twinkle 6s ease-in-out infinite;
      animation-delay: var(--d);
    }
  }
  @keyframes u-twinkle {
    50% {
      opacity: 0.12;
    }
  }

  .u-controls {
    position: absolute;
    right: 0.75rem;
    top: 0.75rem;
    display: grid;
    gap: 0.25rem;
    padding: 0.25rem;
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--bg-elev) 85%, transparent);
    border: 1px solid var(--line);
    backdrop-filter: blur(6px);
  }
  .u-controls .icon-btn {
    min-width: 2.25rem;
    height: 2.25rem;
    padding: 0;
  }
  .u-legend {
    position: absolute;
    left: 0.9rem;
    bottom: 0.75rem;
    right: 0.9rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1rem;
    align-items: center;
    font-size: 0.75rem;
    color: var(--ink-3);
    pointer-events: none;
  }
  .u-legend > span {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .u-legend svg {
    width: 14px;
    height: 14px;
    fill: var(--kind-bright);
    stroke: var(--kind-bright);
  }
  .u-legend [data-kind='work'] ellipse {
    fill: none;
    stroke-width: 1.2;
  }
  .u-legend [data-kind='work'] circle {
    stroke: none;
  }
  .u-stats {
    margin-left: auto;
  }
  .u-tooltip {
    position: absolute;
    z-index: 3;
    width: min(18rem, calc(100% - 1.5rem));
    padding: 0.85rem 1rem;
    border-radius: var(--radius);
    border: 1px solid var(--line-strong);
    background: color-mix(in srgb, var(--bg-elev) 94%, transparent);
    backdrop-filter: blur(8px);
    box-shadow: var(--shadow-m);
    pointer-events: none;
    display: grid;
    gap: 0.3rem;
  }
  .u-tooltip[hidden] {
    display: none;
  }
  .u-tooltip.pinned {
    pointer-events: auto;
  }
  .ut-kind {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--kind);
  }
  .ut-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-1);
    line-height: 1.3;
  }
  .ut-desc {
    font-size: var(--step--1);
    color: var(--ink-2);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .ut-open {
    display: none;
    font-size: var(--step--1);
    font-weight: 600;
    align-items: center;
    gap: 0.3rem;
    margin-top: 0.2rem;
  }
  .u-tooltip.pinned .ut-open {
    display: inline-flex;
  }
  .u-hint {
    position: absolute;
    left: 50%;
    top: 0.9rem;
    transform: translate(-50%, -6px);
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-pill);
    background: var(--ink);
    color: var(--bg);
    font-size: 0.78rem;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 250ms,
      transform 250ms;
    white-space: nowrap;
  }
  .u-hint.show {
    opacity: 0.92;
    transform: translate(-50%, 0);
  }

  .u-list {
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    background: var(--bg-elev);
    padding: 0.8rem 1.2rem;
  }
  .u-list summary {
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 500;
    color: var(--ink-2);
  }
  .u-list[open] summary {
    margin-bottom: var(--space-m);
  }
  .u-list-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: var(--space-l);
  }
  .u-list h3 {
    font-size: var(--step-1);
    margin-bottom: 0.4rem;
    font-style: italic;
  }
  .u-list ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.3rem;
  }
  .u-list li {
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
    justify-content: space-between;
    font-size: var(--step--1);
    border-left: 2px solid var(--kind-bright);
