---
import { SITE } from '~/site.config';
import { LOCALES, url, type Lang } from '~/i18n/utils';

export interface SeoProps {
  lang: Lang;
  title?: string;
  description?: string;
  /** Đường dẫn ảnh OG (đã có base) hoặc URL tuyệt đối */
  image?: string;
  type?: 'website' | 'article';
  /** URL của trang ở từng ngôn ngữ (đã có base) — dùng cho hreflang */
  alternates?: Partial<Record<Lang, string>>;
  published?: Date;
  modified?: Date;
  tags?: string[];
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const {
  lang,
  title,
  description = SITE.description[lang],
  image = url(`/og/default/${lang}.png`),
  type = 'website',
  alternates = {},
  published,
  modified,
  tags = [],
  jsonLd,
  noindex = false,
} = Astro.props as SeoProps;

const site = Astro.site!;
const fullTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} — ${SITE.tagline[lang]}`;
const canonical = new URL(Astro.url.pathname, site).href;
const imageUrl = new URL(image, site).href;
const rss = url(lang === 'en' ? '/en/rss.xml' : '/rss.xml');
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}
{
  Object.entries(alternates).map(([l, href]) => (
    <link rel="alternate" hreflang={l} href={new URL(href!, site).href} />
  ))
}
{alternates.vi && <link rel="alternate" hreflang="x-default" href={new URL(alternates.vi, site).href} />}

<meta property="og:site_name" content={SITE.name} />
<meta property="og:type" content={type} />
<meta property="og:title" content={title ?? fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={LOCALES[lang].replace('-', '_')} />
{published && <meta property="article:published_time" content={published.toISOString()} />}
{modified && <meta property="article:modified_time" content={modified.toISOString()} />}
{tags.map((tag) => <meta property="article:tag" content={tag} />)}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title ?? fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

<link rel="alternate" type="application/rss+xml" title={`${SITE.name} (${lang.toUpperCase()})`} href={rss} />
{ld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', ...obj })} />)}
